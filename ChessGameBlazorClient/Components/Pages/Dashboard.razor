@page "/Dashboard"
@using ChessGame.Infrastructure.Infrastructure.Hubs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Http.Connections
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using SharedResources.Contracts.DTOs
@using SharedResources.DTOs.IdentityDTOs.ResponseDTOs
@using ChessGameBlazorClient.ApiServices
@using ChessGameBlazorClient.ServiceEndpoints
@using ChessGameBlazorClient.UI.Services
@inject SignalRService SignalRService
@inject NavigationManager Navigation
@inject IdentityService identityService
@inject IJSRuntime JS;

<h3>Dashboard 2</h3>

@if (activeGamers.Count == 0)
{
    <p>No players online</p>
}
else
{
    <ul>
        @foreach (var player in activeGamers)
        {
            <li>
                @player
                <button @onclick="() => SendInviteAsync(player.Key)">Invite</button>
            </li>
        }
    </ul>
}

@code {
    Dictionary<string, string> activeGamers = new();
    private HubConnection? _hubConnection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _hubConnection = SignalRService.GetHubConnection(JS);
            await _hubConnection.StartAsync();

            var playerIds = GameHub.Connections.Select(kvp => kvp.Key).ToList();
            var gamers = await _hubConnection.InvokeAsync<List<UserDTO>>("GetOnlinePlayersAsync", playerIds);
            activeGamers = gamers.ToDictionary(u => u.UserGuid, u => $"{u.FirstName}{u.LastName}");
            StateHasChanged();
        }
    }


    public async Task SendInviteAsync(string playerId)
    {
        await _hubConnection!.InvokeAsync("SendInvite", playerId);
    }
}