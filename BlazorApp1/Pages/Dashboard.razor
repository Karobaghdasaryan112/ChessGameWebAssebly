@page "/Dashboard"
@using ChessGame.Infrastructure.Infrastructure.Hubs
@using Microsoft.AspNetCore.Http.Connections
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using WebAssemblyChessGame.UI.ServiceEndpoints
@using WebAssemblyChessGame.UI.Services
@inject SignalRService SignalRService
@inject NavigationManager Navigation

<h3>Dashboard 2</h3>

@if (activeGamers.Count == 0)
{
    <p>No players online</p>
}
else
{
    <ul>
        @foreach (var player in activeGamers)
        {
            <li>
                @player
                <button @onclick="() => SendInviteAsync(player)">Invite</button>
            </li>
        }
    </ul>
}

@code {
    List<string> activeGamers = new();
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        _hubConnection = SignalRService.GetHubConnection();

        await _hubConnection.StartAsync();

        await _hubConnection.SendAsync("AcceptInvite", "Id");
    }

    public async Task SendInviteAsync(string playerId)
    {
        await _hubConnection!.InvokeAsync("AcceptInvite", playerId);
    }
}
