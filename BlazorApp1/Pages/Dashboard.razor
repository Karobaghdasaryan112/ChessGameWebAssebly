@page "/Dashboard"
@using ChessGame.Infrastructure.Infrastructure.Hubs
@using Microsoft.AspNetCore.Http.Connections
@using Microsoft.AspNetCore.SignalR
@using Microsoft.AspNetCore.SignalR.Client
@using SharedResources.Contracts.DTOs
@using SharedResources.DTOs.IdentityDTOs.ResponseDTOs
@using WebAssemblyChessGame.UI.ApiServices
@using WebAssemblyChessGame.UI.ServiceEndpoints
@using WebAssemblyChessGame.UI.Services
@inject SignalRService SignalRService
@inject NavigationManager Navigation
@inject IdentityService identityService
@inject IJSRuntime JS;

<h3>Dashboard 2</h3>

@if (activeGamers.Count == 0)
{
    <p>No players online</p>
}
else
{
    <ul>
        @foreach (var player in activeGamers)
        {
            <li>
                @player
                <button @onclick="() => SendInviteAsync(player.Key)">Invite</button>
            </li>
        }
    </ul>
}

@code {
    Dictionary<string,string> activeGamers = new();
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        string jwtToken = await JS.InvokeAsync<string>("getCookie", "access_token");
        _hubConnection = SignalRService.GetHubConnection(jwtToken);

        await _hubConnection.StartAsync();

        var playerIds = GameHub.Connections.Select(KeyValuePair => KeyValuePair.Key).ToList();


        var gamers =  await _hubConnection!.InvokeAsync<List<UserDTO>>("GetOnlinePlayersAsync", playerIds);

        activeGamers = gamers.ToDictionary(user => user.UserGuid, user => $"{user.FirstName}{user.LastName}");
    }

    public async Task SendInviteAsync(string playerId)
    {
        await _hubConnection!.InvokeAsync("SendInvite", playerId);
    }
}
