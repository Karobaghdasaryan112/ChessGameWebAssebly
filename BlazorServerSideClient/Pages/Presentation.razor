@page "/Presentation"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS

<WebSiteClosedTracker/>
<HeadContent>
    <link rel="stylesheet" href="css/components/Presentation.css" />
</HeadContent>
<div class="presentation-shell" tabindex="0" @onkeydown="HandleKey">

    <div class="aurora one"></div>
    <div class="aurora two"></div>
    <div class="aurora three"></div>
    <div class="deck-frame">
        <header class="topbar">
            <div class="brand">
                <div class="brand-mark">♞</div>
                <div><strong>Chess Arena</strong><span>Diploma project · Solution architecture</span></div>
            </div>
            <div class="top-actions">
                <button class="deck-btn" @onclick="ToggleFullScreen">Fullscreen</button>
                <a class="deck-btn primary" href="https://github.com/Karobaghdasaryan112/ChessGameWebAssebly"
                   target="_blank">GitHub</a>
            </div>
        </header>

        <main class="slide-stage">
            <section class="slide @(IsActive(0))">
                <div class="hero-grid">
                    <div>
                        <div class="eyebrow reveal">Clean Architecture · Real-time Chess</div>
                        <h1 class="reveal d1">ChessGame Application</h1>
                        <p class="lead reveal d2">Շախմատային առցանց հարթակ՝ ստեղծված <strong>.NET</strong>, <strong>Blazor
                                Server</strong>, <strong>SignalR</strong>, <strong>MediatR</strong> և <strong>Clean
                                Architecture</strong> սկզբունքների հիման վրա։</p>
                        <div class="metric-row reveal d3">
                            <div class="metric"><b>Real-time</b><span>SignalR խաղային կապ</span></div>
                            <div class="metric"><b>CQRS</b><span>MediatR command/query</span></div>
                            <div class="metric"><b>AI</b><span>Alpha-Beta search</span></div>
                        </div>
                    </div>
                    <div class="chess-orb reveal d2">
                        <div class="chess-board-ghost"></div>
                    </div>
                </div>
            </section>

            <section class="slide @(IsActive(1))">
                <div class="eyebrow reveal">Project overview</div>
                <h2 class="reveal d1">Համակարգի ընդհանուր գաղափարը</h2>
                <p class="lead reveal d2">Նախագիծը կառուցված է որպես մոդուլային համակարգ, որտեղ յուրաքանչյուր շերտ ունի
                    հստակ պատասխանատվություն․ UI-ը ցուցադրում է խաղը, Gateway-ը կառավարում է մուտքը, API-ները մշակում են
                    հարցումները, իսկ Core շերտը պահում է հիմնական բիզնես տրամաբանությունը։</p>
                <div class="grid-3 reveal d3">
                    <div class="card"><span class="card-label">Frontend</span>
                        <h3>BlazorServerSideClient</h3>
                        <p>Razor components, խաղատախտակի ինտերֆեյս, lobby և SignalR client կապեր։</p></div>
                    <div class="card"><span class="card-label">Gateway</span>
                        <h3>Gateway.API</h3>
                        <p>YARP Reverse Proxy՝ միասնական մուտքի կետ, երթուղավորում և սերվիսների բաժանում։</p></div>
                    <div class="card"><span class="card-label">Backend</span>
                        <h3>Chess / Chat / Identity APIs</h3>
                        <p>Խաղի տրամաբանություն, հաղորդագրություններ, authentication և real-time events։</p></div>
                </div>
            </section>

            <section class="slide @(IsActive(2)) scroll">
                <div class="eyebrow reveal">Architecture map</div>
                <h2 class="reveal d1">Clean Architecture շերտավորում</h2>
                <div class="arch-map reveal d2">
                    <div class="arch-column"><span class="card-label">Presentation</span>
                        <div class="arch-pill"><strong>BlazorServerSideClient</strong><br/><span>UI, Razor Components, SignalR Client</span>
                        </div>
                        <div class="arch-pill"><strong>SharedResources</strong><br/><span>DTO-ներ, Contracts, ընդհանուր մոդելներ</span>
                        </div>
                    </div>
                    <div class="arch-column"><span class="card-label">Application / Core</span>
                        <div class="arch-pill"><strong>ChessGame.Core.Domain</strong><br/><span>Շախմատի կանոններ և դոմեյնային entities</span>
                        </div>
                        <div class="arch-pill"><strong>ChessGame.Core.Services</strong><br/><span>MediatR, CQRS, Commands, Queries, AI logic</span>
                        </div>
                    </div>
                    <div class="arch-column"><span class="card-label">Infrastructure</span>
                        <div class="arch-pill"><strong>Infrastructure</strong><br/><span>SignalR services, external implementations, DI</span>
                        </div>
                        <div class="arch-pill"><strong>Persistence</strong><br/><span>EF Core, DbContext, repositories, migrations</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="slide @(IsActive(3)) scroll">
                <div class="eyebrow reveal">Solution structure</div>
                <h2 class="reveal d1">Visual Studio Solution կառուցվածք</h2>
                <div class="grid-2 reveal d2">
                    <div class="tree">
                        <div class="folder">📁 Applications</div>
                        <div class="file">📦 BlazorServerSideClient</div>
                        <div class="file">📦 Gateway.API</div>
                        <div class="file">📦 webAssemblyChessGame.Services.ChessGameAPI</div>
                        <div class="file">📦 webAssemblyChessGame.Services.ChatAPI</div>
                        <div class="file">📦 webAssemblyChessGame.Services.IdentityService</div>
                        <div class="folder">📁 Shared</div>
                        <div class="file violet">📦 SharedResources</div>
                    </div>
                    <div class="tree">
                        <div class="folder">📁 Core</div>
                        <div class="file">📄 Domain entities · Board · Figure · Move</div>
                        <div class="file">📄 Commands · Queries · Handlers</div>
                        <div class="file">📄 GetOptimizedMoveQueryHandler</div>
                        <div class="folder">📁 Infrastructure</div>
                        <div class="file green">📄 ChessGameDbContext</div>
                        <div class="file green">📄 Repositories</div>
                        <div class="file green">📄 SignalRGameHubService</div>
                    </div>
                </div>
            </section>

            <section class="slide @(IsActive(4))">
                <div class="eyebrow reveal">Blazor UI</div>
                <h2 class="reveal d1">Ներկայացման շերտ</h2>
                <div class="grid-2 reveal d2">
                    <div class="card"><span class="card-label">UI Experience</span>
                        <h3>Խաղատախտակ և Lobby</h3>
                        <p>Blazor Server-ը ապահովում է ինտերակտիվ միջավայր՝ խաղացողի քայլերը, հրավերները և ընթացիկ խաղի
                            վիճակը վիզուալացնելու համար։</p>
                        <ul>
                            <li>Razor Components</li>
                            <li>Real-time status updates</li>
                            <li>Server-driven validation result</li>
                        </ul>
                    </div>
                    <div class="card"><span class="card-label">State Strategy</span>
                        <h3>Backend-ը մնում է truth source</h3>
                        <p>UI-ը չի որոշում քայլի թույլատրելիությունը․ այն միայն ուղարկում է գործողությունը և ցուցադրում
                            է սերվերի կողմից հաստատված արդյունքը։ Սա բարձրացնում է անվտանգությունն ու տվյալների
                            ամբողջականությունը։</p></div>
                </div>
            </section>

            <section class="slide @(IsActive(5))">
                <div class="eyebrow reveal">Gateway.API</div>
                <h2 class="reveal d1">YARP Reverse Proxy</h2>
                <div class="card reveal d2"><span class="card-label">Single Entry Point</span>
                    <p class="lead">Gateway.API-ն ծառայում է որպես համակարգի կենտրոնական մուտք։ Այն թաքցնում է ներքին
                        սերվիսների տեղակայումը և ապահովում է միավորված երթուղավորում դեպի Chess, Chat և Identity
                        service-ներ։</p>
                    <ul>
                        <li>Կլիենտը կապվում է մեկ հասցեի հետ։</li>
                        <li>Սերվիսները կարելի է անկախ տեղափոխել կամ մասշտաբավորել։</li>
                        <li>Ապագայում կարելի է ավելացնել rate limiting, logging և authorization policy-ներ։</li>
                    </ul>
                </div>
            </section>

            <section class="slide @(IsActive(6))">
                <div class="eyebrow reveal">Backend APIs</div>
                <h2 class="reveal d1">Սերվերային շերտի պատասխանատվությունը</h2>
                <div class="grid-3 reveal d2">
                    <div class="card"><span class="card-label">ChessGameAPI</span>
                        <h3>GameHub</h3>
                        <p>Կառավարում է խաղային իրադարձությունները, քայլերը, հրավերները և խաղացողների միջև ակնթարթային
                            հաղորդակցությունը։</p></div>
                    <div class="card"><span class="card-label">ChatAPI</span>
                        <h3>Messages</h3>
                        <p>Առանձին մոդուլ՝ խաղացողների հաղորդագրությունների և chat սցենարների համար։</p></div>
                    <div class="card"><span class="card-label">IdentityService</span>
                        <h3>Authentication</h3>
                        <p>Օգտատերերի գրանցում, մուտք, token/cookie անվտանգության կառավարում և identity տվյալներ։</p>
                    </div>
                </div>
            </section>

            <section class="slide @(IsActive(7))">
                <div class="eyebrow reveal">Domain Core</div>
                <h2 class="reveal d1">Շախմատի կանոնների անկախ միջուկ</h2>
                <div class="grid-2 reveal d2">
                    <div class="card"><span class="card-label">Entities</span>
                        <ul>
                            <li><strong>Board</strong> — 8x8 խաղատախտակի վիճակ։</li>
                            <li><strong>Figure</strong> — խաղաքարի տիպ, գույն և դիրք։</li>
                            <li><strong>Move</strong> — քայլի սկզբնակետ, վերջնակետ և տեսակը։</li>
                        </ul>
                    </div>
                    <div class="card"><span class="card-label">Rules</span>
                        <ul>
                            <li>Legal move validation</li>
                            <li>Check և checkmate detection</li>
                            <li>Castling, promotion և հատուկ շախմատային իրավիճակներ</li>
                            <li>Խաղի վիճակի վերահսկում սերվերային մակարդակում</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="slide @(IsActive(8))">
                <div class="eyebrow reveal">CQRS · MediatR</div>
                <h2 class="reveal d1">Application Logic</h2>
                <div class="grid-2 reveal d2">
                    <div class="card"><span class="card-label">Commands</span>
                        <h3>Փոփոխող գործողություններ</h3>
                        <p>Քայլի կատարում, խաղի սկսում, վիճակի թարմացում և database persist։</p>
                        <ul>
                            <li>MoveLogicCommandHandler</li>
                            <li>SubmitMoveCommandHandler</li>
                            <li>StartGameCommandHandler</li>
                        </ul>
                    </div>
                    <div class="card"><span class="card-label">Queries</span>
                        <h3>Ընթերցման գործողություններ</h3>
                        <p>Խաղերի պատմության, առցանց խաղացողների և AI-ի օպտիմալ քայլի ստացում։</p>
                        <ul>
                            <li>GetGameHistoryQueryHandler</li>
                            <li>GetOnlinePlayersQueryHandler</li>
                            <li>GetOptimizedMoveQueryHandler</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="slide @(IsActive(9))">
                <div class="eyebrow reveal">Data flow</div>
                <h2 class="reveal d1">Մեկ քայլի մշակման ճանապարհը</h2>
                <div class="card reveal d2">
                    <div class="flow">
                        <div class="flow-packet"></div>
                        <div class="flow-node">Client UI<small>Blazor Click</small></div>
                        <div class="flow-node">Gateway<small>YARP route</small></div>
                        <div class="flow-node">ChessAPI<small>SignalR Hub</small></div>
                        <div class="flow-node">Core<small>MediatR + Domain</small></div>
                        <div class="flow-node">Database<small>EF Core</small></div>
                    </div>
                </div>
                <p class="lead reveal d3">Քայլը ստացվում է UI-ից, անցնում Gateway-ով, մշակվում GameHub-ում, հաստատվում
                    Core Domain կանոններով, պահպանվում բազայում և SignalR-ի միջոցով անմիջապես վերադարձվում երկու
                    խաղացողներին։</p>
            </section>

            <section class="slide @(IsActive(10))">
                <div class="eyebrow reveal">AI engine</div>
                <h2 class="reveal d1">Արհեստական բանականության մոդուլ</h2>
                <div class="grid-2 reveal d2">
                    <div class="card"><span class="card-label">Search</span>
                        <h3>Alpha-Beta Pruning</h3>
                        <p>AI-ը որոնում է լավագույն քայլը՝ կրճատելով խաղային ծառի ոչ օգտակար ճյուղերը և պահպանելով
                            հաշվարկի արագությունը։</p></div>
                    <div class="card"><span class="card-label">Evaluation</span>
                        <h3>Board Evaluation</h3>
                        <p>Դիրքը գնահատվում է նյութական արժեքի և դիրքային առավելությունների հիման վրա․ օրինակ՝
                            խաղաքարերի ակտիվություն, կենտրոնի վերահսկում և պաշտպանություն։</p></div>
                </div>
            </section>

            <section class="slide @(IsActive(11))">
                <div class="eyebrow reveal">Deployment</div>
                <h2 class="reveal d1">Անվտանգություն և տեղակայում</h2>
                <div class="grid-2 reveal d2">
                    <div class="card"><span class="card-label">Security</span>
                        <p>IdentityService-ը պատասխանատու է օգտատիրոջ վավերացման համար, իսկ API մակարդակում կարելի է
                            կիրառել authorization policy-ներ և պաշտպանված SignalR կապեր։</p>
                        <ul>
                            <li>ASP.NET Core Identity</li>
                            <li>Secure authentication flow</li>
                            <li>Gateway-based boundary</li>
                        </ul>
                    </div>
                    <div class="card"><span class="card-label">Docker</span>
                        <p>Docker Compose-ը հնարավորություն է տալիս գործարկել բոլոր հիմնական մասերը մեկ միջավայրում՝
                            frontend, gateway, backend service-ներ և տվյալների բազա։</p>
                        <ul>
                            <li>Reproducible local environment</li>
                            <li>Service isolation</li>
                            <li>Production-ready deployment direction</li>
                        </ul>
                    </div>
                </div>
            </section>

            <section class="slide @(IsActive(12))">
                <div class="eyebrow reveal">Conclusion</div>
                <h2 class="reveal d1">Եզրակացություն</h2>
                <div class="card reveal d2" style="text-align:center; max-width: 980px; margin:auto;">
                    <div style="font-size:72px; margin-bottom:18px;">♚</div>
                    <h3>Շնորհակալություն ուշադրության համար</h3>
                    <p class="lead" style="margin-left:auto; margin-right:auto;">Ներկայացված լուծումը ցույց է տալիս, որ
                        շախմատային real-time հարթակը կարելի է կառուցել մաքուր, ընդլայնվող և սպասարկելի
                        ճարտարապետությամբ՝ պահպանելով շերտերի պատասխանատվությունը և տեխնիկական ճկունությունը։</p>
                    <a class="deck-btn primary" href="https://github.com/Karobaghdasaryan112/ChessGameWebAssebly"
                       target="_blank">Դիտել նախագիծը GitHub-ում</a>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div class="counter">SLIDE <strong>@(CurrentSlide + 1)</strong> / @TotalSlides</div>
            <div class="progress-wrap">
                <div class="progress" style="--progress:@ProgressPercent%"></div>
            </div>
            <div class="nav">
                <button class="deck-btn" @onclick="Prev" disabled="@(CurrentSlide == 0)">Նախորդը</button>
                <button class="deck-btn primary" @onclick="Next" disabled="@(CurrentSlide == TotalSlides - 1)">Հաջորդը
                </button>
            </div>
        </footer>
    </div>
</div>

@code {
    private int CurrentSlide { get; set; } = 0;
    private const int TotalSlides = 13;
    private double ProgressPercent => ((CurrentSlide + 1) * 100.0) / TotalSlides;
    private string IsActive(int index) => CurrentSlide == index ? "active" : string.Empty;

    private void Next()
    {
        if (CurrentSlide < TotalSlides - 1) CurrentSlide++;
    }

    private void Prev()
    {
        if (CurrentSlide > 0) CurrentSlide--;
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight" || e.Key == " ") Next();
        if (e.Key == "ArrowLeft") Prev();
    }

    private async Task ToggleFullScreen()
    {
        await JS.InvokeVoidAsync("eval", "document.fullscreenElement ? document.exitFullscreen() : document.querySelector('.presentation-shell')?.requestFullscreen()");
    }

}
