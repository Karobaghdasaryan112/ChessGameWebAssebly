            <div class="counter">SLIDE <strong>@(CurrentSlide + 1)</strong> / @TotalSlides</div>
            <div class="progress-wrap"><div class="progress" style="--progress:@ProgressPercent%"></div></div>
            <div class="nav">
                <button class="deck-btn" @onclick="Prev" disabled="@(CurrentSlide == 0)">Նախորդը</button>
                <button class="deck-btn primary" @onclick="Next" disabled="@(CurrentSlide == TotalSlides - 1)">Հաջորդը</button>
            </div>
        </footer>
