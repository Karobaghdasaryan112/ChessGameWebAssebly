@page "/HistoryWidgets"

@using System.Globalization
@using System.Security.Claims
@using ChessGameBlazorClient.ApiServices
@using SharedResources.ChessGameResource.Enums.Events
@using SharedResources.DTOs.ChessGameDTOs.ChessGameSharedDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.GameRequestDTOs

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState
@inject ChessGameService ChessGameService

<PageTitle>Game History</PageTitle>
<link href="css/components/HistoryWidgets.css"/>
@if (_isLoading)
{
    <section class="history-widget">
        <div class="history-loading-card">
            <div class="history-spinner"></div>
            <div>
                <h3>Loading history</h3>
                <p>Please wait while we prepare your recent matches.</p>
            </div>
        </div>
    </section>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="history-widget">
        <div class="history-error-card">
            <div class="error-icon">!</div>
            <div>
                <h3>Something went wrong</h3>
                <p>@_error</p>
            </div>
        </div>
    </section>
}
else if (!HasOpponents)
{
    <section class="history-widget">
        <div class="history-empty-card">
            <div class="empty-chess-icon">♟</div>
            <h2>No games yet</h2>
            <p>Your match history will appear here after you finish your first game.</p>

            <div class="empty-actions">
                <button class="history-primary-btn" @onclick="NavigateToDashboard">
                    Find Opponent
                </button>

                <button class="history-secondary-btn" @onclick="NavigateToTraining">
                    Train vs AI
                </button>
            </div>
        </div>
    </section>
}
else
{
    var currentOpponent = CurrentOpponentName;
    var currentGames = GamesForCurrentOpponent.ToList();

    <section class="history-widget">
        <div class="history-header">
            <div>
                <span class="history-kicker">Chess Arena</span>
                <h2>Match History</h2>
                <p>Review your latest games, opponents, results, and match duration.</p>
            </div>

            <div class="history-header-actions">
                <button class="history-icon-btn"
                        title="Previous opponent"
                        disabled="@IsFirstOpponent"
                        @onclick="PreviousOpponentAsync">
                    ‹
                </button>

                <div class="opponent-card">
                    <span>Current opponent</span>
                    <strong>@currentOpponent</strong>
                    <small>@CurrentOpponentTotalGames game@(CurrentOpponentTotalGames == 1 ? "" : "s") played</small>
                </div>

                <button class="history-icon-btn"
                        title="Next opponent"
                        disabled="@IsLastOpponent"
                        @onclick="NextOpponentAsync">
                    ›
                </button>
            </div>
        </div>

        <div class="history-summary-grid">
            <article class="summary-card">
                <span>Total Opponents</span>
                <strong>@Opponents.Count</strong>
            </article>

            <article class="summary-card">
                <span>Total vs Current</span>
                <strong>@CurrentOpponentTotalGames</strong>
            </article>

            <article class="summary-card">
                <span>Current Page</span>
                <strong>@(CurrentPage + 1) / @TotalPagesForCurrentOpponent()</strong>
            </article>
        </div>

        @if (!currentGames.Any())
        {
            <div class="history-empty-small">
                <div>♙</div>
                <h3>No games with this opponent</h3>
                <p>Try selecting another opponent or play a new match.</p>
            </div>
        }
        else
        {
            <div class="history-games-grid">
                @foreach (var game in currentGames)
                {
                    var result = GetGameResult(game);
                    var resultClass = ResultClass(result);

                    <article class="history-game-card @resultClass">
                        <div class="game-card-top">
                            <div>
                                <span class="game-label">Opponent</span>
                                <h3>@game.Opponent</h3>
                            </div>

                            <span class="result-pill @resultClass">
                                @result
                            </span>
                        </div>

                        <div class="game-card-body">
                            <div class="game-meta-item">
                                <span class="meta-icon">⏱</span>
                                <div>
                                    <small>Duration</small>
                                    <strong>@FormatDuration(game.Duration)</strong>
                                </div>
                            </div>

                            <div class="game-meta-item">
                                <span class="meta-icon">📅</span>
                                <div>
                                    <small>Date</small>
                                    <strong>@FormatDate(game.Date)</strong>
                                </div>
                            </div>

                            <div class="game-meta-item">
                                <span class="meta-icon">🕒</span>
                                <div>
                                    <small>Time</small>
                                    <strong>@FormatTime(game.Date)</strong>
                                </div>
                            </div>
                        </div>

                        <div class="game-card-footer">
                            <button class="view-game-btn"
                                    @onclick="() => GoToGameHistory(game.player1Name, game.player2Name, game.GameId)">
                                View Game
                            </button>

                            <span class="game-id-preview">
                                @ShortGameId(game.GameId)
                            </span>
                        </div>
                    </article>
                }
            </div>
        }

        <footer class="history-footer">
            <div class="history-pager">
                <button class="history-page-btn"
                        disabled="@IsFirstPage"
                        @onclick="PreviousPageAsync">
                    ← Previous
                </button>

                <div class="page-indicator">
                    Page <strong>@(CurrentPage + 1)</strong> of <strong>@TotalPagesForCurrentOpponent()</strong>
                </div>

                <button class="history-page-btn"
                        disabled="@IsLastPage"
                        @onclick="NextPageAsync">
                    Next →
                </button>
            </div>

            <div class="history-footer-actions">
                <button class="history-secondary-btn" @onclick="NavigateToDashboard">
                    Back to Lobby
                </button>
            </div>
        </footer>
    </section>
}

@code {
    private const int CardsPerPage = 8;

    private int CurrentOpponentIndex;
    private int CurrentPage;

    private ClaimsPrincipal _user = new(new ClaimsIdentity());
    private Guid _currentUserGuid;

    private bool _isLoading = true;
    private string? _error;

    private readonly List<KeyValuePair<OpponentAndGameId, Guid>> Opponents = new();
    private readonly List<KeyValuePair<OpponentAndGameId, int>> OpponentsAndTotalGamesCount = new();
    private readonly Dictionary<string, List<HistoryGameDTO>> GamesByOpponent = new();

    private bool HasOpponents => Opponents.Count > 0;

    private bool IsFirstOpponent => CurrentOpponentIndex <= 0;

    private bool IsLastOpponent => !HasOpponents || CurrentOpponentIndex >= Opponents.Count - 1;

    private bool IsFirstPage => CurrentPage <= 0;

    private bool IsLastPage => CurrentPage >= TotalPagesForCurrentOpponent() - 1;

    private string CurrentOpponentName =>
        HasOpponents
            ? Opponents[CurrentOpponentIndex].Key.Opponent
            : string.Empty;

    private int CurrentOpponentTotalGames =>
        !HasOpponents
            ? 0
            : OpponentsAndTotalGamesCount
                .FirstOrDefault(item => item.Key.Opponent == CurrentOpponentName)
                .Value;

    private IEnumerable<HistoryGameDTO> GamesForCurrentOpponent
    {
        get
        {
            if (!HasOpponents)
                return Enumerable.Empty<HistoryGameDTO>();

            return GamesByOpponent.TryGetValue(CurrentOpponentName, out var games)
                ? games
                : Enumerable.Empty<HistoryGameDTO>();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            _user = authState.User;

            if (_user.Identity?.IsAuthenticated != true)
            {
                NavigationManager.NavigateTo("/Identity/Account/Login?returnUrl=/HistoryWidgets", true);
                return;
            }

            var userIdValue = _user.Claims.FirstOrDefault(claim => claim.Type == ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userIdValue) || !Guid.TryParse(userIdValue, out _currentUserGuid))
            {
                _error = "Could not detect the current user.";
                return;
            }

            await InitializeAllGamesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task InitializeAllGamesAsync()
    {
        var response = await ChessGameService.GetAllHistoryWidgetsAsync(new GetAllHistoryWidgetRequestDTO
        {
            CurrentPlayerId = _currentUserGuid
        });

        var opponentHistories = response?.Data?.OpponentHistories?.ToList();

        if (!opponentHistories.Any())
            return;

        var groupedOpponents = opponentHistories
            .GroupBy(history => history.Opponent)
            .Select(group => group.First())
            .ToList();

        Opponents.Clear();
        OpponentsAndTotalGamesCount.Clear();
        GamesByOpponent.Clear();

        foreach (var opponentHistory in groupedOpponents)
        {
            var opponentInfo = new OpponentAndGameId
            {
                Opponent = opponentHistory.Opponent,
                GameId = opponentHistory.GameId
            };

            Opponents.Add(new KeyValuePair<OpponentAndGameId, Guid>(
                opponentInfo,
                opponentHistory.OpponentGuid
            ));

            OpponentsAndTotalGamesCount.Add(new KeyValuePair<OpponentAndGameId, int>(
                opponentInfo,
                opponentHistory.TotalCount
            ));

            GamesByOpponent[opponentHistory.Opponent] = new List<HistoryGameDTO>();
        }

        CurrentOpponentIndex = 0;
        CurrentPage = 0;

        await LoadCurrentOpponentGamesAsync();
    }

    private async Task LoadCurrentOpponentGamesAsync()
    {
        if (!HasOpponents)
            return;

        CurrentOpponentIndex = Math.Clamp(CurrentOpponentIndex, 0, Opponents.Count - 1);
        CurrentPage = Math.Clamp(CurrentPage, 0, TotalPagesForCurrentOpponent() - 1);

        var currentOpponent = Opponents[CurrentOpponentIndex];

        var response = await ChessGameService.GetGamesPaginationPerOpponentAsync(
            new GetGamesByCurrentAndOpponentIdsPaginationRequestDTO
            {
                CurrentPlayerGuid = _currentUserGuid,
                OpponentPlayerGuid = currentOpponent.Value,
                CurrentPage = CurrentPage,
                PageSize = CardsPerPage
            });

        var games = response?.Data?.AllGamesHistories?.ToList() ?? new List<HistoryGameDTO>();

        GamesByOpponent[currentOpponent.Key.Opponent] = games;
    }

    private int TotalPagesForCurrentOpponent()
    {
        if (!HasOpponents)
            return 1;

        var totalGames = CurrentOpponentTotalGames;

        if (totalGames <= 0)
            return 1;

        return Math.Max(1, (int)Math.Ceiling(totalGames / (double)CardsPerPage));
    }

    private async Task PreviousPageAsync()
    {
        if (IsFirstPage)
            return;

        CurrentPage--;
        await LoadCurrentOpponentGamesAsync();
    }

    private async Task NextPageAsync()
    {
        if (IsLastPage)
            return;

        CurrentPage++;
        await LoadCurrentOpponentGamesAsync();
    }

    private async Task PreviousOpponentAsync()
    {
        if (IsFirstOpponent)
            return;

        CurrentOpponentIndex--;
        CurrentPage = 0;

        await LoadCurrentOpponentGamesAsync();
    }

    private async Task NextOpponentAsync()
    {
        if (IsLastOpponent)
            return;

        CurrentOpponentIndex++;
        CurrentPage = 0;

        await LoadCurrentOpponentGamesAsync();
    }

    private void GoToGameHistory(string currentPlayerName, string opponentPlayerName, Guid gameId)
    {
        var url =
            $"/GameHistory?Player1Name={Uri.EscapeDataString(currentPlayerName)}" +
            $"&Player2Name={Uri.EscapeDataString(opponentPlayerName)}" +
            $"&GameId={gameId}";

        NavigationManager.NavigateTo(url);
    }

    private void NavigateToDashboard()
    {
        NavigationManager.NavigateTo("/Dashboard");
    }

    private void NavigateToTraining()
    {
        NavigationManager.NavigateTo("/Training");
    }

    private string GetGameResult(HistoryGameDTO game)
    {
        if (game.GameEvent != GameEvent.Over)
            return game.GameEvent.ToString();

        if (game.WinnerPlayerGuid == _currentUserGuid)
            return "Win";

        if (game.WinnerPlayerGuid == Guid.Empty)
            return "Draw";

        return "Lose";
    }

    private static string ResultClass(string? result)
    {
        return result?.ToLowerInvariant() switch
        {
            "win" => "res-win",
            "lose" => "res-lose",
            "draw" => "res-draw",
            "over" => "res-draw",
            _ => "res-draw"
        };
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? duration.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture)
            : duration.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    private static string FormatDate(DateTime date)
    {
        return date.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
    }

    private static string FormatTime(DateTime date)
    {
        return date.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    private static string ShortGameId(Guid gameId)
    {
        var value = gameId.ToString("N");
        return value.Length <= 8 ? value : value[..8];
    }

    private sealed class OpponentAndGameId
    {
        public string Opponent { get; set; } = string.Empty;

        public Guid GameId { get; set; }
    }
}