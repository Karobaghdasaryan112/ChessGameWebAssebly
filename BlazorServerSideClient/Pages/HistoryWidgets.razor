@page "/HistoryWidgets"
@using System.Globalization
@using System.Security.Claims
@inject NavigationManager NavigationManager
@using ChessGameBlazorClient.ApiServices
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using SharedResources.ChessGameResource.Enums.Events
@using SharedResources.DTOs.ChessGameDTOs.ChessGameSharedDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.GameRequestDTOs
@inject AuthenticationStateProvider AuthState
@inject ChessGameService ChessGameService

@code {
    private int CardsPerPage = 8;
    private int CurrentOpponentIndex = 0;
    private int CurrentPage = 0;

    private ClaimsPrincipal _user;
    private Guid _currentUserGuid;
    private bool _isLoading = true;
    private string? _error = string.Empty;


    private List<HistoryGameDTO> AllGames = new();

    private List<KeyValuePair<string, int>> OpponentsAndToalGamesCount = new();

    private List<KeyValuePair<string, Guid>> Opponents = new();

    private Dictionary<string, List<HistoryGameDTO>> GamesByOpponent = new();

    protected override async Task OnInitializedAsync()
    {

        _user = (await AuthState.GetAuthenticationStateAsync()).User;
        UnAuthorizedUser();
        _currentUserGuid = Guid.Parse(_user.Claims.Where(Claim => Claim.Type == ClaimTypes.NameIdentifier).First().Value);

        if (!AllGames.Any())
            try
            {
                await InitializeAllGames();
                _isLoading = false;
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
    }
    private void UnAuthorizedUser()
    {
        if (_user.Identity?.IsAuthenticated == false)
            NavigationManager.NavigateTo("/Identity/Account/Login?returnUrl=/HistoryWidgets", true);
    }


    private IEnumerable<HistoryGameDTO> PagedGamesForCurrentOpponent()
    {
        if (Opponents == default || !Opponents.Any()) return Enumerable.Empty<HistoryGameDTO>();
        var keyValuePair = Opponents[CurrentOpponentIndex];
        if (!GamesByOpponent.TryGetValue(keyValuePair.Key, out var value)) return Enumerable.Empty<HistoryGameDTO>();

        return value;
    }

    private int TotalPagesForCurrentOpponent()
    {
        var keyValuePair = Opponents[CurrentOpponentIndex];
        var opponentAndGamesCountPair = OpponentsAndToalGamesCount.FirstOrDefault(gamesCount => keyValuePair.Key == gamesCount.Key);
        if (opponentAndGamesCountPair.Equals(default(KeyValuePair<string, int>)) || opponentAndGamesCountPair.Value == 0) return 1;
        return Math.Max(1, (int)Math.Ceiling(opponentAndGamesCountPair.Value / (double)CardsPerPage));
    }
    //per current Opponent Pages
    private async Task PrevPage()
    {
        if (CurrentPage > 0) CurrentPage--;
        await GroupGames();
    }
    private async Task NextPage()
    {
        var x = TotalPagesForCurrentOpponent();
        if (CurrentPage < TotalPagesForCurrentOpponent() - 1) CurrentPage++;

        await GroupGames();
    }
    //per current Opponent Pages


    //Next Opponent

    private async Task PrevOpponent()
    {
        if (CurrentOpponentIndex > 0) CurrentOpponentIndex--;
        CurrentPage = 0;

        await GroupGames();
    }
    private async Task NextOpponent()
    {
        if (CurrentOpponentIndex < Opponents.Count - 1) CurrentOpponentIndex++;
        CurrentPage = 0;

        await GroupGames();
    }

    private async Task GoToNextOpponent()
    {
        if (CurrentOpponentIndex < Opponents.Count - 1)
            CurrentOpponentIndex++;

        CurrentPage = 0;
        await GroupGames();
    }
    //Next Opponent


    private string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalHours >= 1) return ts.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture);
        return ts.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }


    private async Task InitializeAllGames()
    {
        var userGuid = Guid.Parse(_user.Claims.First(claim => claim.Type == ClaimTypes.NameIdentifier)?.Value!);

        var allGameHistories = await ChessGameService.GetAllHistoryWidgetsAsync(new GetAllHistoryWidgetRequestDTO()
        {
            CurrentPlayerId = userGuid,
        });

        Opponents.AddRange(
            allGameHistories?.Data.OpponentHistories.ToDictionary(groupGame =>
                groupGame.Opponent, groupGame =>
                groupGame.OpponentGuid) ?? []);

        OpponentsAndToalGamesCount.AddRange(allGameHistories?.Data.OpponentHistories.ToDictionary(groupGame =>
                groupGame.Opponent, groupGame =>
                groupGame.TotalCount) ?? []);

        Opponents.ForEach(opponent => GamesByOpponent[opponent.Key] = []);

        await GroupGames();
    }

    private async Task GroupGames()
    {
        if (Opponents == default || !Opponents.Any())
            return;

        var userGuid = Guid.Parse(_user.Claims.First(claim => claim.Type == ClaimTypes.NameIdentifier)?.Value!);

        var gamesPaginationPerOpponentResponse = await ChessGameService.GetGamesPaginationPerOpponentAsync(new GetGamesByCurrentAndOpponentIdsPaginationRequestDTO()
        {
            CurrentPlayerGuid = userGuid,
            CurrentPage = this.CurrentPage,
            PageSize = CardsPerPage,
            OpponentPlayerGuid = Opponents[CurrentOpponentIndex].Value
        });

        var gamesPaginationPerOpponentResult = gamesPaginationPerOpponentResponse?.Data;

        GamesByOpponent[Opponents[CurrentOpponentIndex].Key] = gamesPaginationPerOpponentResult.AllGamesHistories;


        CurrentOpponentIndex = Math.Min(CurrentOpponentIndex, Opponents.Count - 1);

    }

    private string ResultClass(string result) => result?.ToLower() switch
    {
        "win" => "res-win",
        "lose" => "res-lose",
        "draw" => "res-draw",
        _ => "res-draw"
    };

    private string ResultLabel(string result) => result;
}
<DashboardInvitationRequest />
@if (_isLoading)
{
    <div class="hw-loading">
        <div class="spinner"></div>
        <span>Loading history...</span>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="hw-error">
        @_error
    </div>
}
else if(Opponents.Any())
{
    <div class="hw-wrap">
        <header class="hw-header">
            <div class="hw-title">
                <h2>History</h2>
                <div class="hw-sub">Recent matches with opponents</div>
            </div>

            <div class="hw-controls">
                <button class="opp-btn" @onclick="PrevOpponent" title="Previous opponent">◀</button>

                <div class="opp-chip" title="Click small button to jump next opponent">
                    <div class="opp-name">@Opponents[CurrentOpponentIndex].Key</div>
                    <div class="opp-meta">
                        <span class="opp-count">
                            @GamesByOpponent[Opponents[CurrentOpponentIndex].Key].Count();
                        </span>
                        <button class="small-next" @onclick="GoToNextOpponent" title="Next opponent">›</button>
                    </div>
                </div>

                <button class="opp-btn" @onclick="NextOpponent" title="Next opponent">▶</button>
            </div>
        </header>

        <section class="hw-grid-area">
            <div class="cards-grid">
                @foreach (var g in PagedGamesForCurrentOpponent())
                {

                    <article class="game-card @ResultClass(g.GameEvent == GameEvent.Over ? g.WinnerPlayerGuid == _currentUserGuid ? "win" : "lose" : g.GameEvent.ToString())">
                        <div class="card-top">
                            <div class="card-opponent">@g.Opponent</div>
                            <div class="card-result">@ResultLabel(g.GameEvent.ToString())</div>
                        </div>

                        <div class="card-body">
                            <div class="meta-row">
                                <div class="meta-item">
                                    <svg class="icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M12 8v4l3 3"></path>
                                        <circle cx="12" cy="12" r="9"></circle>
                                    </svg>
                                    <span class="meta-text">@FormatDuration(g.Duration)</span>
                                </div>

                                <div class="meta-item">
                                    <svg class="icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                        <path d="M16 2v4"></path>
                                        <path d="M8 2v4"></path>
                                    </svg>
                                    <span class="meta-text">@g.Date.ToLocalTime().ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer">
                            <button class="view-btn" @onclick="() => GoToGameHistory(g.player1Name, g.player2Name, g.GameId)">View</button>
                            <div class="badge">@g.Date.ToLocalTime().ToString("HH:mm")</div>
                        </div>
                    </article>
                }
            </div>

            @if (!GamesByOpponent.ContainsKey(Opponents[CurrentOpponentIndex].Key) || !Opponents[CurrentOpponentIndex].Key.Any())
            {
                <div class="empty">No games yet with this opponent.</div>
            }
    </section>

        <footer class="hw-footer">
            <div class="pager">
                <button class="pg-btn"
                        @onclick="PrevPage"
                        @attributes="PrevDisabled">
                    ← Prev
                </button>

                <div class="pg-info">
                    Page <strong>@(CurrentPage + 1)</strong>
                    of <strong>@TotalPagesForCurrentOpponent()</strong>
                </div>

                <button class="pg-btn"
                        @onclick="NextPage"
                        @attributes="NextDisabled">
                    Next →
                </button>
            </div>

            <div class="bottom-actions">
                <button class="primary">Open full history</button>
            </div>
        </footer>

    @code {
        private Dictionary<string, object>? PrevDisabled =>
        CurrentPage == 0
        ? new() { ["disabled"] = true }
        : null;

        private Dictionary<string, object>? NextDisabled =>
        CurrentPage >= TotalPagesForCurrentOpponent() - 1
        ? new() { ["disabled"] = true }
        : null;

        public async Task GoToGameHistory(string currentPlayerName, string opponentPlayerName, Guid gameId)
        {
            var query = $"/GameHistory?Player1Name={currentPlayerName}&Player2Name={opponentPlayerName}&GameId={gameId}";
            NavigationManager.NavigateTo(query, true);
        }
    }
</div>
}
else
{
    <div class="empty">No games yet.</div>
}