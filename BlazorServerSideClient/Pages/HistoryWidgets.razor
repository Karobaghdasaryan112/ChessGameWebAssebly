@page "/HistoryWidgets"
@using System.Globalization
@using BlazorServerSideClient.Services.Requests
@inject AuthenticationStateProvider AuthState
@inject HistoryWidgetRequestService HistoryWidgetsRequestService

@code {
    public class HistoryGameDTO
    {
        public string Opponent { get; set; }
        public string Result { get; set; }
        public TimeSpan Duration { get; set; }
        public DateTime Date { get; set; }
    }

    private int CardsPerPage = 6;
    private int CurrentOpponentIndex = 0;
    private int CurrentPage = 0;

    private List<HistoryGameDTO> AllGames = new();

    private List<string> Opponents = new();
    private Dictionary<string, List<HistoryGameDTO>> GamesByOpponent = new();

    protected override void OnInitialized()
    {
        if (!AllGames.Any())
        {
            InitializeAllGames();
        }

        GroupGames();
    }

    private void GroupGames()
    {
        GamesByOpponent = AllGames
            .GroupBy(g => g.Opponent)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.Date).ToList());

        Opponents = GamesByOpponent.Keys.ToList();
        if (Opponents.Count == 0) Opponents.Add("No opponents");
        CurrentOpponentIndex = Math.Min(CurrentOpponentIndex, Opponents.Count - 1);
        CurrentPage = 0;
    }

    private IEnumerable<HistoryGameDTO> PagedGamesForCurrentOpponent()
    {
        var key = Opponents[CurrentOpponentIndex];
        if (!GamesByOpponent.TryGetValue(key, out var value)) return Enumerable.Empty<HistoryGameDTO>();

        return value
            .Skip(CurrentPage * CardsPerPage)
            .Take(CardsPerPage);
    }

    private int TotalPagesForCurrentOpponent()
    {
        var key = Opponents[CurrentOpponentIndex];
        if (!GamesByOpponent.TryGetValue(key, out var value)) return 1;
        var count = value.Count;
        return Math.Max(1, (int)Math.Ceiling(count / (double)CardsPerPage));
    }

    private void PrevPage()
    {
        if (CurrentPage > 0) CurrentPage--;
    }
    private void NextPage()
    {
        if (CurrentPage < TotalPagesForCurrentOpponent() - 1) CurrentPage++;
    }

    private void PrevOpponent()
    {
        if (CurrentOpponentIndex > 0) CurrentOpponentIndex--;
        CurrentPage = 0;
    }
    private void NextOpponent()
    {
        if (CurrentOpponentIndex < Opponents.Count - 1) CurrentOpponentIndex++;
        CurrentPage = 0;
    }

    private void GoToNextOpponent()
    {
        CurrentOpponentIndex = (CurrentOpponentIndex + 1) % Opponents.Count;
        CurrentPage = 0;
    }

    private string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalHours >= 1) return ts.ToString(@"h\:mm\:ss", CultureInfo.InvariantCulture);
        return ts.ToString(@"m\:ss", CultureInfo.InvariantCulture);
    }

    private void InitializeAllGames()
    {

        AllGames = new List<HistoryGameDTO>();
        var rnd = new Random();
        var opponents = new[] { "Mike Taylor", "Carson Lewis", "Evelyn Reed", "Rapey Jenkins", "Michael Robertson" };

        foreach (var opp in opponents)
        {
            var count = rnd.Next(3, 12);
            for (int i = 0; i < count; i++)
            {
                var result = (i % 3 == 0) ? "Win" : (i % 3 == 1) ? "Lose" : "Draw";
                AllGames.Add(new HistoryGameDTO
                {
                    Opponent = opp,
                    Result = result,
                    Duration = TimeSpan.FromSeconds(rnd.Next(60 * 2, 60 * 20)),
                    Date = DateTime.UtcNow.AddDays(-rnd.Next(0, 120)).AddMinutes(-rnd.Next(0, 600))
                });
            }
        }
    }


    private Task GetAllOpponents()
    {
        throw new NotImplementedException();
    }

    private string ResultClass(string result) => result?.ToLower() switch
    {
        "win" => "res-win",
        "lose" => "res-lose",
        "draw" => "res-draw",
        _ => "res-draw"
    };

    private string ResultLabel(string result) => result?.ToLower() switch
    {
        "win" => "Win",
        "lose" => "Lose",
        "draw" => "Draw",
        _ => "Unknown"
    };
}
<div class="hw-wrap">
    <header class="hw-header">
        <div class="hw-title">
            <h2>History</h2>
            <div class="hw-sub">Recent matches with opponents</div>
        </div>

        <div class="hw-controls">
            <button class="opp-btn" @onclick="PrevOpponent" title="Previous opponent">◀</button>

            <div class="opp-chip" title="Click small button to jump next opponent">
                <div class="opp-name">@Opponents[CurrentOpponentIndex]</div>
                <div class="opp-meta">
                    <span class="opp-count">@GamesByOpponent[Opponents[CurrentOpponentIndex]].Count</span>
                    <button class="small-next" @onclick="GoToNextOpponent" title="Next opponent">›</button>
                </div>
            </div>

            <button class="opp-btn" @onclick="NextOpponent" title="Next opponent">▶</button>
        </div>
    </header>

    <section class="hw-grid-area">
        <div class="cards-grid">
            @foreach (var g in PagedGamesForCurrentOpponent())
            {
                <article class="game-card @ResultClass(g.Result)">
                    <div class="card-top">
                        <div class="card-opponent">@g.Opponent</div>
                        <div class="card-result">@ResultLabel(g.Result)</div>
                    </div>

                    <div class="card-body">
                        <div class="meta-row">
                            <div class="meta-item">
                                <svg class="icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M12 8v4l3 3"></path>
                                    <circle cx="12" cy="12" r="9"></circle>
                                </svg>
                                <span class="meta-text">@FormatDuration(g.Duration)</span>
                            </div>

                            <div class="meta-item">
                                <svg class="icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                    <path d="M16 2v4"></path>
                                    <path d="M8 2v4"></path>
                                </svg>
                                <span class="meta-text">@g.Date.ToLocalTime().ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <button class="view-btn">View</button>
                        <div class="badge">@g.Date.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                </article>
            }
        </div>

        @if (!GamesByOpponent.ContainsKey(Opponents[CurrentOpponentIndex]) || !GamesByOpponent[Opponents[CurrentOpponentIndex]].Any())
        {
            <div class="empty">No games yet with this opponent.</div>
        }
    </section>

    <footer class="hw-footer">
        <div class="pager">
            <button class="pg-btn" @onclick="PrevPage" disabled="@(CurrentPage == 0)">← Prev</button>
            <div class="pg-info">Page <strong>@(CurrentPage + 1)</strong> of <strong>@TotalPagesForCurrentOpponent()</strong></div>
            <button class="pg-btn" @onclick="NextPage" disabled="@(CurrentPage >= TotalPagesForCurrentOpponent() - 1)">Next →</button>
        </div>

        <div class="bottom-actions">
            <button class="primary">Open full history</button>
        </div>
    </footer>
</div>
