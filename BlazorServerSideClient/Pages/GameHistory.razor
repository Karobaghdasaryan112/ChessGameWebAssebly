@page "/GameHistory"
@using System.Security.Claims
@using System.Text.Json
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Services
@using ChessGame.Core.Services.Extentions
@using ChessGameBlazorClient.ApiServices
@using ChessGameBlazorClient.UI.Services
@using SharedResources.ChessGameResource.Enums.Colors
@using SharedResources.ChessGameResource.Models
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.GameRequestDTOs
@inject ChessGameService ChessGameService
@inject SignalRService HubClient
@inject JSRunetimeService JS
@inject AuthenticationStateProvider AuthenticationState

<div class="game-history-wrap">
    <div class="leftCard">
        <div class="playersInfo">
            <div class="player">
                <div class="avatar" id="avatar1">P1</div>
                <div class="playerInfo">
                    <span class="name" id="player1Name">Player 1: —</span>
                    <span class="meta" id="player1Meta">Rating: — · Online</span>
                </div>
            </div>

            <div style="text-align:center">
                <div style="font-weight:800">Game Page</div>
                <div style="color:var(--muted);font-size:13px;margin-top:4px">Friendly match · Blitz 5+0</div>
            </div>

        </div>
    </div>
    <div class="history-nav">
        <button id="prevBtn" class="nav-btn" @onclick="ReceivePreviousStateAsync">⟵ Prev</button>

        <div class="nav-middle">
            <span class="move-label">Move</span>
            <span id="moveIndex" class="move-number">@CurrentState</span>
        </div>

        <button id="nextBtn" class="nav-btn" @onclick="ReceiveNextStateAsync">Next ⟶</button>
    </div>

    <div class="boardWrap">
        <div id="chessboard" class="chessboard" aria-label="Chessboard" role="grid"></div>
    </div>

</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "Player1Name")]
    public string? Player1Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player2Name")]
    public string? Player2Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "GameId")]
    public Guid GameId { get; set; }

    private DotNetObjectReference<GameHistory>? DotNetRef;

    private FigureColors MyColor => currentUserName == Player1Name ? FigureColors.White : FigureColors.Black;


    private string currentUserName => (AuthenticationState.GetAuthenticationStateAsync().GetAwaiter().GetResult()).User.Claims.First(claim => claim.Type == ClaimTypes.Name).Value;

    private string currentUserGuid => (AuthenticationState.GetAuthenticationStateAsync().GetAwaiter().GetResult()).User.Claims.First(claim => claim.Type == ClaimTypes.NameIdentifier).Value;

    private List<string> BoardStatesAsJson = new();
    private List<Board> BoardStates = new();

    private Board? PreviusBoardState { get; set; }
    private Board? NextBoardState { get; set; }

    private int CurrentState { get; set; } = 0;

    private int FigureColor { get; set; }



    protected override async Task OnInitializedAsync()
    {
        //configure Hub Connection
        await HubClient.GetHubConnection();
        await HubClient.RegisterConnectionHandlers();

        await JS.ShowPlayers(Player1Name!, Player2Name!);



        DotNetRef = DotNetObjectReference.Create(this);

        FigureColor = currentUserName == Player1Name ? 0 : 1;


        //Setup gameStates from Server
        var gameStatesResponse = await ChessGameService.GetGameHistoryAsync(new GetGameHistoryRequestDTO()
        {
            GameId = GameId
        });

        var boardStates = gameStatesResponse?.Data.FEN!;


        //Add States to class property
        boardStates.ForEach(boardState =>
        {
            var board = boardState.FromFenToBoard();
            BoardStates.Add(board);
        });

        //convert first State to JSON
        var startStateAsJson = JsonSerializer.Serialize(boardStates[0].FromFenToBoard().BoardBlocks);


        //Show state
        await JS.ShowBoardState(startStateAsJson!, FigureColor, DotNetRef);
    }



    //Privet Methods
    private async Task ReceivePreviousStateAsync()
    {
        if (CurrentState > 0 && CurrentState <= BoardStates.Count() - 1)
        {
            CurrentState--;

            SetUpPreviousAndNextBoardState();
            var blockChangesHistory = BoardStates[CurrentState + 1].CompareTo(BoardStates[CurrentState]);

            await JS.ReceiveBlockChangesHistory(blockChangesHistory);
        }
    }

    private async Task ReceiveNextStateAsync()
    {
        if (CurrentState >= 0 && CurrentState < BoardStates.Count() - 1)
        {

            CurrentState++;

            SetUpPreviousAndNextBoardState();
            var blockChangesHistory = BoardStates[CurrentState - 1].CompareTo(BoardStates[CurrentState]);

            await JS.ReceiveBlockChangesHistory(blockChangesHistory);
        }
    }

    private void SetUpPreviousAndNextBoardState()
    {
        int previousIndex = 0;
        int nextIndex = 0;

        previousIndex = Math.Clamp(CurrentState - 1, 0, BoardStates.Count - 1);
        nextIndex = Math.Clamp(CurrentState + 1, 0, BoardStates.Count - 1);

        PreviusBoardState = BoardStates[previousIndex];
        NextBoardState = BoardStates[nextIndex];

    }

}