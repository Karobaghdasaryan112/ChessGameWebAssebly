@page "/game"
@using System.Security.Claims
@using System.Text.Json
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Services
@using ChessGameBlazorClient.UI.Services
@using Microsoft.AspNetCore.SignalR.Client
@using SharedResources.ChessGameResource.Enums.Colors
@using SharedResources.ChessGameResource.Enums.Events
@using SharedResources.ChessGameResource.Models
@using SharedResources.DTOs.ChessGameDTOs.ChessGameSharedDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.MediatRRequestDTOs
@inject SignalRService HubClient
@inject IGameRequestService GameRequestService
@inject JSRunetimeService JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationState
@attribute [Authorize]
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script src="~/Js/site.js"></script>
</head>
<div class="wrap">
    <div class="leftCard">
        <div class="playersInfo">
            <div class="player">
                <div class="avatar" id="avatar1">P1</div>
                <div class="playerInfo">
                    <span class="name" id="player1Name">Player 1: —</span>
                    <span class="meta" id="player1Meta">Rating: — · Online</span>
                </div>
            </div>

            <div style="text-align:center">
                <div style="font-weight:800">Game Page</div>
                <div style="color:var(--muted);font-size:13px;margin-top:4px">Friendly match · Blitz 5+0</div>
            </div>

            <div class="controls">
                <button class="btn" id="btnUndo" title="Undo last">↶ Undo</button>
                <button class="btn" id="btnOffer" title="Offer draw">🤝 Offer</button>
                <button class="btn primary" id="btnNew" title="New game">✳ New Game</button>
            </div>
        </div>

        <div class="boardWrap">
            <div id="chessboard" class="chessboard" aria-label="Chessboard" role="grid"></div>
        </div>
    </div>

    <aside class="rightCard">
        <div class="panelTitle">
            <h4>Move Log</h4>
            <div style="color:var(--muted);font-size:13px">Live</div>
            <div id="Logger-Div">
            </div>
        </div>

        <div class="movesLog" id="movesLog">
        </div>

        <div style="height:12px"></div>

        <div class="panelTitle">
            <h4>Players</h4>
            <div style="color:var(--muted);font-size:13px">Status</div>
        </div>

        <div style="display:flex;flex-direction:column;gap:8px">
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="avatar" style="width:44px;height:44px;border-radius:10px">W</div>
                <div>
                    <div style="font-weight:700">White — @Player1Name </div>
                    <div style="font-size:13px;color:var(--muted)">Time: 4:58</div>
                </div>
            </div>

            <div style="display:flex;align-items:center;gap:10px;">
                <div class="avatar" style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#111827,#0b1530)">B</div>
                <div>
                    <div style="font-weight:700">Black — @Player2Name</div>
                    <div style="font-size:13px;color:var(--muted)">Time: 4:58</div>
                </div>
            </div>
        </div>

    </aside>
</div>

@code {
    //Parameters

    [Parameter]
    [SupplyParameterFromQuery(Name = "GameId")]
    public Guid GameId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player1")]
    public string Player1Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player2")]
    public string Player2Name { get; set; }

    //Parameters



    //Properties

    private HubConnection? _hubConnection;

    private ClickedBlockInformationDTO ClickedBlockInformationDTO = new ClickedBlockInformationDTO();

    private FigureColors MyColor => currentUserName == Player1Name ? FigureColors.White : FigureColors.Black;

    private static UserConnectionDTO currentUser => new UserConnectionDTO();

    private string currentUserName => (AuthenticationState.GetAuthenticationStateAsync().GetAwaiter().GetResult()).User.Claims.First(claim => claim.Type == ClaimTypes.Name).Value;

    private string currentUserGuid => (AuthenticationState.GetAuthenticationStateAsync().GetAwaiter().GetResult()).User.Claims.First(claim => claim.Type == ClaimTypes.NameIdentifier).Value;

    //Properties
    //Reqeusts
    private ConnectionRequestDTO<MoveRequestDTO> MoveRequestDTO = new ConnectionRequestDTO<MoveRequestDTO>() { Data = new() };
    private ConnectionRequestDTO<ClickRequestDTO> ClickRequestDTO = new ConnectionRequestDTO<ClickRequestDTO>() { Data = new() };




    //Lifecycle Methods

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (!firstRender)
            return;

        _hubConnection = await HubClient.GetHubConnection();

        await JS.ShowPlayers(Player1Name, Player2Name);

        var thisBoard = await GameRequestService.SendGameStateAsync(
            new ConnectionRequestDTO<SendGameStateReqeustDTO>()
            {
                Data = new SendGameStateReqeustDTO()
                {
                    GameId = GameId
                }
            });

        var blocks = thisBoard.Data.Board.BoardBlocks;
        var jsonBoard = JsonSerializer.Serialize(blocks);

        int figureColor = currentUserName == Player1Name ? 0 : 1;

        var dotNetRef = DotNetObjectReference.Create(this);

        await JS.ShowBoardState(jsonBoard, figureColor, dotNetRef);

        InitializeRequests(GameId, currentUserName, MyColor, ClickedBlockInformationDTO);
    }



    protected override async Task OnInitializedAsync()
    {
        await HubClient.GetHubConnection();
        await HubClient.RegisterConnectionHandlers();
    }

    //JS Methods
    [JSInvokable]
    public async void OnCellClick(int row, int col)
    {
        await HubClient.GetHubConnection();
        await HubClient.RegisterConnectionHandlers();

        await JS.ClearSelectedBlocks((int)MyColor);


        SetUpRequestsPositions(new Position(row, col));

        var selectedPosition = ClickedBlockInformationDTO?.ClickedPosition;

        if (selectedPosition != default)
        {
            if (await IsSameFigureColor(selectedPosition, MoveRequestDTO.Data.CurrentPosition, GameId))
            {
                await SelectFigure(ClickRequestDTO);
                return;
            }

            await Move(MoveRequestDTO);
            return;
        }

        await SelectFigure(ClickRequestDTO);
    }


    //private Methods

    private Task<bool> IsSameFigureColor(Position selectedPosition, Position currentPosition, Guid gameId)
    {
        return GameRequestService.SendIsSameFigureClickedAsync(selectedPosition, currentPosition, gameId);
    }

    private async Task<bool> SelectFigure(ConnectionRequestDTO<ClickRequestDTO> requestDTO)
    {

        var positionsResult = await GameRequestService.SendClickAsync(requestDTO);

        if (!positionsResult.IsSuccess)
            return false;

        await JS.ShowMovableCutableBlocks(positionsResult.Data.CutableBlocks!, positionsResult.Data.MovableBlocks!);
        ClickedBlockInformationDTO!.ClickedPosition = requestDTO.Data.CurrentPosition;
        ClickedBlockInformationDTO.GameId = requestDTO.Data.GameId;

        return true;
    }

    private async Task<bool> Move(ConnectionRequestDTO<MoveRequestDTO> requestDTO)
    {
        //request Data Setup
        requestDTO.Data.To = requestDTO.Data.From;
        requestDTO.Data.From = ClickedBlockInformationDTO.ClickedPosition;
        requestDTO.Data.CurrentPlayerId = Guid.Parse(currentUserGuid);

        var positionsResult = await GameRequestService.SendMoveAsync(requestDTO);

        if (!positionsResult.IsSuccess)
            return false;

        if (positionsResult.Data.IsReadyToEvent == IsReady.IsReadyToMove)
            await JS.UpdateBoardAfterMove(requestDTO.Data.From, requestDTO.Data.To, (int)MyColor);
        else
            await JS.UpdateBoardAfterCut(requestDTO.Data.From, requestDTO.Data.To, (int)MyColor);

        ClickedBlockInformationDTO.ClickedPosition = default;
        return true;
    }

    //Request Methods
    private void InitializeRequests(Guid gameId, string player, FigureColors myColor, ClickedBlockInformationDTO PreviusBlockInformationDTO)
    {
        MoveRequestDTO.Data.GameId = gameId;
        ClickRequestDTO.Data.GameId = gameId;

        MoveRequestDTO.Data.Player = player;
        ClickRequestDTO.Data.Player = player;

        MoveRequestDTO.Data.MyColor = myColor;
        ClickRequestDTO.Data.MyColor = myColor;

        MoveRequestDTO.Data.PreviusBlockInformationDTO = PreviusBlockInformationDTO;
        ClickRequestDTO.Data.PreviusBlockInformationDTO = PreviusBlockInformationDTO;
    }
    private void SetUpRequestsPositions(Position from)
    {
        MoveRequestDTO.Data.CurrentPosition = from;
        MoveRequestDTO.Data.From = from;
        ClickRequestDTO.Data.CurrentPosition = from;
        ClickRequestDTO.Data.From = from;
    }

    //JS Methods

    public async Task SendMoveAsync(string move)
    {

    }
}
