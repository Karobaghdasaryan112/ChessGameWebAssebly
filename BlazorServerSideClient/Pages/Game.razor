@page "/game"
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Services
@using BlazorServerSideClient.Services.Requests
@using ChessGameBlazorClient.ServiceEndpoints
@using ChessGameBlazorClient.UI.Services
@using Microsoft.AspNetCore.SignalR.Client
@using SharedResources.ChessGameResource.Models
@using SharedResources.ChessGameResource.StaticResources
@using SharedResources.DTOs.ChessGameDTOs.ChessGameSharedDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs
@using System.Web
@using System.Collections.Specialized
@inject SignalRService HubClient
@inject IGameRequestService GameRequestService
@inject JSRunetimeService JS
@inject NavigationManager Navigation
@attribute [Authorize]
<h3>Game Page</h3>

<p id="Player1">Player 1: @Player1?.UserName</p>
<p id="Player2">Player 2: @Player2?.UserName</p>
<div id="chessboard">
</div>

<style>
    #chessboard {
        display: inline-block;
        border: 2px solid #333;
    }

    .row {
        display: flex;
    }

    .cell {
        width: 100px;
        height: 100px;
    }

    .white {
        background-color: #f0d9b5;
    }

    .black {
        background-color: #b58863;
    }
</style>

@if (_hubConnection == null)
{
    <p>Connecting to game server...</p>
}
else
{
    <p>Connected to game hub</p>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "GameId")]
    public Guid GameId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player1")]
    public string Player1Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player2")]
    public string Player2Name { get; set; }

    private static UserConnectionDTO Player1 => new();

    private static UserConnectionDTO Player2 => new();


    private HubConnection? _hubConnection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _hubConnection = await HubClient.GetHubConnection();

        await JS.ShowPlayers(Player1Name, Player2Name);


    }

    protected override async Task OnInitializedAsync()
    {
        await HubClient.RegisterConnectionHandlers();
        var thisBaord = await GameRequestService.SendGameStateAsync(
            new ConnectionRequestDTO<SendGameStateReqeustDTO>()
            {
                Data = new SendGameStateReqeustDTO()
                { 
                    GameId = GameId
                }
            });


        await JS.ShowBoardState(thisBaord.Data.Board);
    }

    public async Task SendMoveAsync(string move)
    {
        await _hubConnection!.InvokeAsync("SendMove", Player1, move);
    }
}
