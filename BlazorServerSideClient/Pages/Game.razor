@page "/game"

@using System.Security.Claims
@using System.Text.Json
@using BlazorServerSideClient.Contracts.Handlers
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Data.GameModels
@using BlazorServerSideClient.Extensions
@using BlazorServerSideClient.Services
@using ChessGameBlazorClient.ApiServices
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.SignalR.Client
@using SharedResources.ChessGameResource.Enums.Colors
@using SharedResources.ChessGameResource.Enums.Events
@using SharedResources.ChessGameResource.Models
@using SharedResources.DTOs.ChessGameDTOs.ChessGameSharedDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.ConnectionResponsDTOs.GameResponseDTOs
@using SharedResources.PipeLine.PipeLineContext

@inject SignalRService HubClient
@inject ChessGameService ChessGameService
@inject IGameRequestService GameRequestService
@inject IGameHandlerService GameHandlerService
@inject JSRunetimeService JS
@inject IJSRuntime JsRuntime
@inject AuthenticationStateProvider AuthenticationState
@inject ILogger<Game> Logger
@inject GameCircuitState GameCircuitState
@inject GameCircuitHandler GameCircuitHandler

@attribute [Authorize]
@implements IAsyncDisposable

<PageTitle>Live Chess Game</PageTitle>

<MateNotifier />
<ErrorModal />

<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="true" />

<section class="game-arena-page @(isBusy ? "game-is-busy" : "")">
    <div class="game-bg-orb game-bg-orb-one"></div>
    <div class="game-bg-orb game-bg-orb-two"></div>
    <div class="game-bg-orb game-bg-orb-three"></div>

    <div class="game-arena-shell">
        <header class="game-topbar">
            <div class="game-brand">
                <div class="game-brand-mark">♞</div>
                <div>
                    <strong>Chess Arena</strong>
                    <span>Live synchronized match</span>
                </div>
            </div>

            <div class="game-top-status">
                <div class="game-status-pill">
                    <span class="status-dot"></span>
                    @_matchState
                </div>

                <div class="game-status-pill">
                    Turn: <strong>@_turnLabel</strong>
                </div>
            </div>
        </header>

        <main class="game-layout">
            <section class="game-board-panel">
                <div class="game-players-strip">
                    <article class="game-player-card white-player @(MyColor == FigureColors.White ? "current-user" : "")">
                        <div class="game-avatar game-avatar-white">
                            @GetInitial(Player1Name)
                        </div>

                        <div class="game-player-info">
                            <span class="game-player-label">White</span>
                            <strong title="@Player1Name">@DisplayName(Player1Name)</strong>
                            <small>@_whiteClock.ToString(@"mm\:ss")</small>
                        </div>
                    </article>

                    <div class="game-match-card">
                        <span>Live Game</span>
                        <strong>@_turnLabel to move</strong>
                        <small>@FormatElapsed(_gameStartedAtUtc)</small>
                    </div>

                    <article class="game-player-card black-player @(MyColor == FigureColors.Black ? "current-user" : "")">
                        <div class="game-avatar game-avatar-black">
                            @GetInitial(Player2Name)
                        </div>

                        <div class="game-player-info">
                            <span class="game-player-label">Black</span>
                            <strong title="@Player2Name">@DisplayName(Player2Name)</strong>
                            <small>@_blackClock.ToString(@"mm\:ss")</small>
                        </div>
                    </article>
                </div>

                <div class="game-controls-bar">
                    <button class="game-btn ghost" title="Undo is not available in live mode" disabled>
                        <span>↶</span>
                        Undo
                    </button>

                    <button class="game-btn ghost" title="Offer draw" @onclick="OfferDraw" disabled="@isBusy">
                        <span>🤝</span>
                        Offer Draw
                    </button>

                    <button class="game-btn primary" title="Leave and start new game" @onclick="StartNewGame" disabled="@isBusy">
                        <span>✳</span>
                        New Game
                    </button>

                    <button class="game-btn helper" @onclick="GetOptimizedMove" disabled="@isBusy">
                        @if (isBusy)
                        {
                            <span class="mini-spinner"></span>
                            <span>Thinking...</span>
                        }
                        else
                        {
                            <span>♟</span>
                            <span>Helper</span>
                        }
                    </button>
                </div>

                <div class="board-stage">
                    <div class="board-frame">
                        <div class="board-rank-labels board-rank-left">
                            @for (var rank = 8; rank >= 1; rank--)
                            {
                                <span>@rank</span>
                            }
                        </div>

                        <div class="board-file-labels board-file-top">
                            @foreach (var file in BoardFiles)
                            {
                                <span>@file</span>
                            }
                        </div>

                        <div id="chessboard" class="chessboard premium-chessboard" aria-label="Chessboard" role="grid"></div>

                        <div class="board-file-labels board-file-bottom">
                            @foreach (var file in BoardFiles)
                            {
                                <span>@file</span>
                            }
                        </div>

                        <div class="board-rank-labels board-rank-right">
                            @for (var rank = 8; rank >= 1; rank--)
                            {
                                <span>@rank</span>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <aside class="game-side-panel">
                <section class="side-card game-overview-card">
                    <div class="side-card-header">
                        <div>
                            <span class="side-kicker">Overview</span>
                            <h3>Match Control</h3>
                        </div>

                        <div class="live-indicator">
                            <span></span>
                            Live
                        </div>
                    </div>

                    <div class="game-stats-grid">
                        <article class="game-stat-card">
                            <span>Elapsed</span>
                            <strong>@FormatElapsed(_gameStartedAtUtc)</strong>
                        </article>

                        <article class="game-stat-card">
                            <span>Turn</span>
                            <strong>@_turnLabel</strong>
                        </article>

                        <article class="game-stat-card">
                            <span>Events</span>
                            <strong>@_gameNotes.Count</strong>
                        </article>

                        <article class="game-stat-card">
                            <span>White Score</span>
                            <strong>@_player1Points</strong>
                        </article>

                        <article class="game-stat-card">
                            <span>Black Score</span>
                            <strong>@_player2Points</strong>
                        </article>

                        <article class="game-stat-card">
                            <span>You Play</span>
                            <strong>@MyColor</strong>
                        </article>
                    </div>
                </section>

                <section class="side-card">
                    <div class="side-card-header">
                        <div>
                            <span class="side-kicker">Players</span>
                            <h3>Table Status</h3>
                        </div>
                    </div>

                    <div class="side-player-list">
                        <article class="side-player-row">
                            <div class="game-avatar game-avatar-white compact-avatar">
                                @GetInitial(Player1Name)
                            </div>

                            <div class="side-player-info">
                                <strong title="@Player1Name">White — @DisplayName(Player1Name)</strong>
                                <span>Score: @_player1Points · Clock: @_whiteClock.ToString(@"mm\:ss")</span>
                            </div>
                        </article>

                        <article class="side-player-row">
                            <div class="game-avatar game-avatar-black compact-avatar">
                                @GetInitial(Player2Name)
                            </div>

                            <div class="side-player-info">
                                <strong title="@Player2Name">Black — @DisplayName(Player2Name)</strong>
                                <span>Score: @_player2Points · Clock: @_blackClock.ToString(@"mm\:ss")</span>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="side-card move-log-card">
                    <div class="side-card-header">
                        <div>
                            <span class="side-kicker">Timeline</span>
                            <h3>Move Log</h3>
                        </div>

                        <span class="log-count">@_gameNotes.Count</span>
                    </div>

                    <div class="movesLog premium-moves-log" id="movesLog">
                        @if (_gameNotes.Count == 0)
                        {
                            <div class="move-note-empty">
                                <div>♙</div>
                                <strong>No moves yet</strong>
                                <span>Moves, captures, helper suggestions, and match events will appear here.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var note in _gameNotes.OrderByDescending(item => item.AtUtc))
                            {
                                <article class="move-note-item @note.KindClass">
                                    <div class="move-note-main">
                                        <strong>@note.Title</strong>
                                        <span>@note.ByPlayer · @note.AtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                    </div>

                                    <div class="move-note-badge">
                                        @note.NoteBadge
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>
            </aside>
        </main>
    </div>
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "GameId")]
    public Guid GameId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player1")]
    public string Player1Name { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player2")]
    public string Player2Name { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "Computer")]
    public bool IsComputerOpponent { get; set; }

    private static readonly string[] BoardFiles = ["a", "b", "c", "d", "e", "f", "g", "h"];

    private bool isBusy;
    private bool _isLeavingGame;

    private readonly string _optimizeMoveLoadingClassName = "chessboard";

    private HubConnection? _hubConnection;
    private Guid _currentUserGuid;
    private string _currentUserName = string.Empty;

    private DotNetObjectReference<Game>? _dotNetRef;

    private readonly List<GameNoteItem> _gameNotes = [];

    private int _player1Points;
    private int _player2Points;

    private DateTime _gameStartedAtUtc = DateTime.UtcNow;
    private TimeSpan _whiteClock = TimeSpan.Zero;
    private TimeSpan _blackClock = TimeSpan.Zero;

    private string _turnLabel = "White";
    private string _matchState = "Running";

    private CancellationTokenSource? _clockLoopCts;

    private ClickedBlockInformationDTO ClickedBlockInformationDTO = new();

    private FigureColors MyColor =>
        string.Equals(_currentUserName, Player1Name, StringComparison.OrdinalIgnoreCase)
            ? FigureColors.White
            : FigureColors.Black;

    private MoveRequestDTO MoveRequestDTO = new();
    private ClickRequestDTO ClickRequestDTO = new();
    private SameFigureRequest SameFigureRequest = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationState.GetAuthenticationStateAsync();

        _currentUserName = authState.User.Claims.First(c => c.Type == ClaimTypes.Name).Value;
        _currentUserGuid = Guid.Parse(authState.User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);

        _hubConnection = await HubClient.GetHubConnectionAsync();

        var connectionId = _hubConnection.ConnectionId;

        GameCircuitState.UserId = _currentUserGuid;
        GameCircuitState.GameId = GameId;
        GameCircuitState.UserConnectionDto = new UserConnectionDTO
        {
            ConnectionId = connectionId!,
            UserName = _currentUserName,
            GameId = GameId
        };

        GameCircuitHandler.GameCircuitState = GameCircuitState;

        StartClockLoop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _hubConnection = await HubClient.GetHubConnectionAsync();

        _dotNetRef?.Dispose();
        _dotNetRef = DotNetObjectReference.Create(this);

        await JS.ShowPlayers(Player1Name, Player2Name);
        await JsRuntime.SafeInvokeWithRetryAsync(Logger, "GameNotesTracker.register", _dotNetRef);

        var thisBoard = await GameRequestService.SendGameStateAsync(
            new PipeLineRequest<SendGameStateReqeustDTO>(
                new SendGameStateReqeustDTO
                {
                    GameId = GameId
                }));

        if (thisBoard.Response.Data?.Board != null)
        {
            var blocks = thisBoard.Response.Data.Board.BoardBlocks;
            var jsonBoard = JsonSerializer.Serialize(blocks);
            var figureColor = _currentUserName == Player1Name ? 0 : 1;

            await JS.ShowBoardState(jsonBoard, figureColor, _dotNetRef);

            InitializeRequests(GameId, _currentUserName, MyColor, ClickedBlockInformationDTO);
        }

        if (IsComputerOpponent && Player1Name == "Computer")
        {
            await AIMoveAtFirst();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (_isLeavingGame)
            return;

        var leave = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            "Do you want to leave the game?"
        );

        if (!leave)
        {
            context.PreventNavigation();
            return;
        }

        context.PreventNavigation();
        _isLeavingGame = true;

        try
        {
            await LeaveGameAsync();
        }
        finally
        {
            _isLeavingGame = false;
        }
    }

    private void StartClockLoop()
    {
        _clockLoopCts?.Cancel();
        _clockLoopCts?.Dispose();

        _clockLoopCts = new CancellationTokenSource();
        var token = _clockLoopCts.Token;

        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(1000, token);

                    if (_matchState != "Running")
                        continue;

                    if (_turnLabel == "White")
                        _whiteClock = _whiteClock.Add(TimeSpan.FromSeconds(1));
                    else
                        _blackClock = _blackClock.Add(TimeSpan.FromSeconds(1));

                    await InvokeAsync(StateHasChanged);
                }
                catch (TaskCanceledException)
                {
                    break;
                }
            }
        }, token);
    }

    public Task OnBoardEvent(string eventType, string from, string to, bool isCapture)
    {
        var byPlayer = _currentUserName;

        var title = eventType switch
        {
            "move" => $"{from} → {to}",
            "capture" => $"{from} × {to}",
            "check" => "King is checked",
            "mate" => "Checkmate",
            "helper" => $"Helper: {from} → {to}",
            _ => eventType
        };

        _gameNotes.Add(new GameNoteItem
        {
            Title = title,
            ByPlayer = byPlayer,
            KindClass = eventType switch
            {
                "capture" => "note-capture",
                "check" => "note-check",
                "mate" => "note-mate",
                "helper" => "note-helper",
                _ => "note-move"
            },
            NoteBadge = eventType.ToUpperInvariant(),
            AtUtc = DateTime.UtcNow
        });

        if (isCapture)
        {
            if (_turnLabel == "White")
                _player1Points++;
            else
                _player2Points++;
        }

        if (eventType is "move" or "capture")
        {
            _turnLabel = _turnLabel == "White" ? "Black" : "White";
        }
        else if (eventType == "mate")
        {
            _matchState = "Finished";
        }

        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnCellClick(int row, int col)
    {
        await HubClient.GetHubConnectionAsync();

        await JS.ClearSelectedBlocks((int)MyColor);

        SetUpRequestsPositions(new Position(row, col));

        var selectedPosition = ClickedBlockInformationDTO?.ClickedPosition;

        if (selectedPosition != null)
        {
            if (await IsSameFigureColor(new Position(row, col), selectedPosition, GameId))
            {
                await SelectFigure(ClickRequestDTO);
                return;
            }

            var successMove = await Move(MoveRequestDTO);

            if (!successMove)
                await SelectFigure(ClickRequestDTO);

            return;
        }

        await SelectFigure(ClickRequestDTO);
    }

    private async Task<bool> IsSameFigureColor(Position selectedPosition, Position currentPosition, Guid gameId)
    {
        SameFigureRequest.Current = currentPosition;
        SameFigureRequest.Selected = selectedPosition;
        SameFigureRequest.GameId = gameId;

        var pipeLineRequest = new PipeLineRequest<SameFigureRequest>
        {
            Request = SameFigureRequest
        };

        var result = await GameRequestService.SendIsSameFigureClickedAsync(pipeLineRequest);

        return result.Response.Data.IsSameFigure;
    }

    private async Task<bool> SelectFigure(ClickRequestDTO requestDTO)
    {
        var pipeLineRequestPositionsResult =
            await GameRequestService.SendClickAsync(new PipeLineRequest<ClickRequestDTO>(requestDTO));

        ClickedBlockInformationDTO.ClickedPosition = requestDTO.CurrentPosition;
        ClickedBlockInformationDTO.GameId = requestDTO.GameId;

        if (!pipeLineRequestPositionsResult.Response.IsSuccess)
            return false;

        await JS.ShowMovableCutableBlocks(
            pipeLineRequestPositionsResult.Response.Data.CutableBlocks!,
            pipeLineRequestPositionsResult.Response.Data.MovableBlocks!,
            pipeLineRequestPositionsResult.Response.Data.CastlingInfosDTOs);

        return true;
    }

    private async Task<bool> Move(MoveRequestDTO requestDTO)
    {
        requestDTO.To = requestDTO.From;
        requestDTO.From = ClickedBlockInformationDTO.ClickedPosition;
        requestDTO.CurrentPlayerId = _currentUserGuid;

        var pipeLineResponsePositionsResult =
            await GameRequestService.SendMoveAsync(new PipeLineRequest<MoveRequestDTO>(requestDTO));

        if (!pipeLineResponsePositionsResult.Response.IsSuccess)
            return false;

        string eventType;
        var isCapture = false;

        if (pipeLineResponsePositionsResult.Response.Data.IsReadyToEvent is IsReady.IsReadyToMove or IsReady.IsReadyToCastle)
        {
            eventType = "move";
            await JS.UpdateBoardAfterMove(requestDTO.From, requestDTO.To, (int)MyColor);
        }
        else
        {
            isCapture = true;
            eventType = "capture";
            await JS.UpdateBoardAfterCut(requestDTO.From, requestDTO.To, (int)MyColor);
        }

        await OnBoardEvent(
            eventType,
            requestDTO.From.ToString(),
            requestDTO.To.ToString(),
            isCapture);

        ClickedBlockInformationDTO.ClickedPosition = default;
        return true;
    }

    private async Task<bool> AIMoveAtFirst()
    {
        var requestDTO = new MoveRequestDTO
        {
            IsAIFirstMove = true,
            GameId = GameId,
            IsOpponentComputer = IsComputerOpponent,
            Player = _currentUserName,
            MyColor = MyColor,
            PreviusBlockInformationDTO = ClickedBlockInformationDTO,
            CurrentPlayerId = Guid.NewGuid(),
            From = new Position(-1, -1),
            To = new Position(-1, -1),
            CurrentPosition = new Position(-1, -1),
            connectionId = _hubConnection?.ConnectionId!
        };

        var pipeLineResponsePositionsResult =
            await GameRequestService.SendMoveAsync(new PipeLineRequest<MoveRequestDTO>(requestDTO));

        if (!pipeLineResponsePositionsResult.Response.IsSuccess)
            return false;

        if (pipeLineResponsePositionsResult.Response.Data.IsReadyToEvent == IsReady.IsReadyToMove)
            await JS.UpdateBoardAfterMove(requestDTO.From, requestDTO.To, (int)MyColor);
        else
            await JS.UpdateBoardAfterCut(requestDTO.From, requestDTO.To, (int)MyColor);

        ClickedBlockInformationDTO.ClickedPosition = default;
        return true;
    }

    private void InitializeRequests(
        Guid gameId,
        string player,
        FigureColors myColor,
        ClickedBlockInformationDTO previusBlockInformationDTO)
    {
        MoveRequestDTO.GameId = gameId;
        ClickRequestDTO.GameId = gameId;
        MoveRequestDTO.IsOpponentComputer = IsComputerOpponent;

        MoveRequestDTO.Player = player;
        ClickRequestDTO.Player = player;

        MoveRequestDTO.MyColor = myColor;
        ClickRequestDTO.MyColor = myColor;

        MoveRequestDTO.PreviusBlockInformationDTO = previusBlockInformationDTO;
        ClickRequestDTO.PreviusBlockInformationDTO = previusBlockInformationDTO;
    }

    private void SetUpRequestsPositions(Position from)
    {
        MoveRequestDTO.CurrentPosition = from;
        MoveRequestDTO.From = from;

        ClickRequestDTO.CurrentPosition = from;
        ClickRequestDTO.From = from;
    }

    private async Task GetOptimizedMove()
    {
        if (isBusy)
            return;

        await JS.DisableAllGameState(_optimizeMoveLoadingClassName);
        isBusy = true;

        try
        {
            var optimizedMoveResponse = await ChessGameService.GetOptimizedMoveAsync(
                new GetOptimizedMoveRequestDTO
                {
                    GameId = GameId,
                    ChosenColor = MyColor,
                    IsMaximizingPlayer = true
                });

            if (optimizedMoveResponse is { IsSuccess: true })
            {
                await JS.ReceiveOptimalMoves(
                    optimizedMoveResponse.Data.FromPosition,
                    optimizedMoveResponse.Data.ToPosition);

                await OnBoardEvent(
                    "helper",
                    optimizedMoveResponse.Data.FromPosition.ToString(),
                    optimizedMoveResponse.Data.ToPosition.ToString(),
                    false);
            }
        }
        finally
        {
            isBusy = false;
            await JS.EnableAllGameState(_optimizeMoveLoadingClassName);
        }
    }

    private async Task LeaveGameAsync()
    {
        _hubConnection = await HubClient.GetHubConnectionAsync();

        var leaveGameRequestDTO = new RemoveUsersFromGameReqeustDTO
        {
            CurerntPlayerGuid = _currentUserGuid,
            GameId = GameId
        };

        var leaveResponse =
            await _hubConnection!.SafeInvokeAsync<RemoveUsersFromGameReqeustDTO, RemoveUserFromGameResponseDTO>(
                "LeaveGameAsync",
                leaveGameRequestDTO,
                JS);

        if (!leaveResponse.Response.IsSuccess)
        {
            await JS.ShowErrorModal("Unable to leave the game right now. Please try again.");
            return;
        }
    }

    private async Task OfferDraw()
    {
        _gameNotes.Add(new GameNoteItem
        {
            Title = "Draw offered",
            ByPlayer = _currentUserName,
            KindClass = "note-helper",
            NoteBadge = "DRAW",
            AtUtc = DateTime.UtcNow
        });

        await InvokeAsync(StateHasChanged);
    }

    private async Task StartNewGame()
    {
        await LeaveGameAsync();
    }

    private static string FormatElapsed(DateTime startedAtUtc)
    {
        var elapsed = DateTime.UtcNow - startedAtUtc;
        return $"{(int)elapsed.TotalMinutes:D2}:{elapsed.Seconds:D2}";
    }

    private static string GetInitial(string? name)
    {
        return string.IsNullOrWhiteSpace(name)
            ? "?"
            : name.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string DisplayName(string? name)
    {
        return string.IsNullOrWhiteSpace(name)
            ? "Unknown Player"
            : name;
    }

    public async ValueTask DisposeAsync()
    {
        _clockLoopCts?.Cancel();
        _clockLoopCts?.Dispose();

        _dotNetRef?.Dispose();

        await Task.CompletedTask;
    }

    private sealed class GameNoteItem
    {
        public string Title { get; set; } = string.Empty;

        public string ByPlayer { get; set; } = string.Empty;

        public string KindClass { get; set; } = "note-move";

        public string NoteBadge { get; set; } = "MOVE";

        public DateTime AtUtc { get; set; } = DateTime.UtcNow;
    }
}gr