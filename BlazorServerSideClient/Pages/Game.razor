@page "/game"
@using System.Security.Claims
@using System.Text.Json
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Services
@using ChessGameBlazorClient.ApiServices
@using Microsoft.AspNetCore.SignalR.Client
@using SharedResources.ChessGameResource.Enums.Colors
@using SharedResources.ChessGameResource.Enums.Events
@using SharedResources.ChessGameResource.Models
@using SharedResources.DTOs.ChessGameDTOs.ChessGameSharedDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.ConnectionResponsDTOs.UserConnectionResponseDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.MediatRResponseDTOs
@using SharedResources.Responses.ResponseMessages
@using SharedResources.Validation.ChessGameValidations.ResponseValidations.ConnectionResponses
@using SharedResources.PipeLine.PipeLineContext
@inject SignalRService HubClient
@inject ChessGameService ChessGameService
@inject IGameRequestService GameRequestService
@inject JSRunetimeService JS
@inject IJSRuntime jsRuneTime
@inject AuthenticationStateProvider AuthenticationState
@attribute [Authorize]
@implements IAsyncDisposable
<MateNotifier/>
<ErrorModal/>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="true">
    @code
    {
        private bool _isLeavingGame;

        private async Task ConfirmLeave(LocationChangingContext context)
        {
            if (_isLeavingGame)
            {
                return;
            }

            var leave = await jsRuneTime.InvokeAsync<bool>(
                "confirm",
                "If you leave the game, you will lose. Do you want to leave?"
            );

            if (!leave)
            {
                context.PreventNavigation();
                return;
            }

            context.PreventNavigation();
            _isLeavingGame = true;

            try
            {
                await LeaveGameAsync();
            }
            finally
            {
                _isLeavingGame = false;
            }
        }
    }
</NavigationLock>
<div class="wrap"
     disabled="@isBusy">
    <div class="leftCard">
        <div class="playersInfo">
            <div class="player">
                <div class="avatar" id="avatar1">@GetInitial(Player1Name)</div>
                <div class="playerInfo">
                    <span class="name" id="player1Name">@Player1Name</span>
                    <span class="meta" id="player1Meta">White · @FormatClock(_whiteClock)</span>
                </div>
            </div>

            <div class="game-center-meta">
                <div class="game-center-title">Live Game</div>
                <div class="game-center-subtitle">Turn: @_turnLabel · Match state: @_matchState</div>
            </div>

            <div class="controls">
                <button class="btn" id="btnUndo" title="Undo is not available in live mode" disabled>↶ Undo</button>
                <button class="btn" id="btnOffer" title="Offer draw" @onclick="OfferDraw">🤝 Offer</button>
                <button class="btn primary" id="btnNew" title="Leave and start new game" @onclick="StartNewGame">✳ New Game</button>
                <button class="btn helper"
                        @onclick="GetOptimizedMove"
                        disabled="@isBusy">
                    ♟️ Helper
                </button>
            </div>
        </div>

        <div class="boardWrap">
            <div id="chessboard" class="chessboard" aria-label="Chessboard" role="grid"></div>
        </div>
    </div>

    <aside class="rightCard">
        <div class="panelTitle">
            <h4>Move Log</h4>
            <div style="color:var(--muted);font-size:13px">Live timeline</div>
        </div>

        <div class="game-stats-grid">
            <div class="game-stat-card">
                <div class="game-stat-label">Elapsed</div>
                <div class="game-stat-value">@FormatElapsed(_gameStartedAtUtc)</div>
            </div>
            <div class="game-stat-card">
                <div class="game-stat-label">Turn</div>
                <div class="game-stat-value">@_turnLabel</div>
            </div>
            <div class="game-stat-card">
                <div class="game-stat-label">Total notes</div>
                <div class="game-stat-value">@_gameNotes.Count</div>
            </div>
            <div class="game-stat-card">
                <div class="game-stat-label">@Player1Name points</div>
                <div class="game-stat-value">@_player1Points</div>
            </div>
            <div class="game-stat-card">
                <div class="game-stat-label">@Player2Name points</div>
                <div class="game-stat-value">@_player2Points</div>
            </div>
        </div>

        <div class="movesLog" id="movesLog">
            @if (_gameNotes.Count == 0)
            {
                <div class="move-note-empty">No notes yet. Moves and events will appear here.</div>
            }
            else
            {
                @foreach (var note in _gameNotes.OrderByDescending(item => item.AtUtc))
                {
                    <div class="move-note-item @note.KindClass">
                        <div>
                            <div class="move-note-title">@note.Title</div>
                            <div class="move-note-meta">@note.ByPlayer · @note.AtUtc.ToLocalTime().ToString("HH:mm:ss")</div>
                        </div>
                        <div class="move-note-badge">@note.NoteBadge</div>
                    </div>
                }
            }
        </div>

        <div class="panelTitle">
            <h4>Players</h4>
            <div style="color:var(--muted);font-size:13px">Status</div>
        </div>

        <div style="display:flex;flex-direction:column;gap:8px">
            <div style="display:flex;align-items:center;gap:10px;">
                <div class="avatar" style="width:44px;height:44px;border-radius:10px">@GetInitial(Player1Name)</div>
                <div>
                    <div style="font-weight:700">White — @Player1Name </div>
                    <div style="font-size:13px;color:var(--muted)">Score: @_player1Points · @FormatClock(_whiteClock)</div>
                </div>
            </div>

            <div style="display:flex;align-items:center;gap:10px;">
                <div class="avatar"
                     style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#111827,#0b1530)">
                    @GetInitial(Player2Name)
                </div>
                <div>
                    <div style="font-weight:700">Black — @Player2Name</div>
                    <div style="font-size:13px;color:var(--muted)">Score: @_player2Points · @FormatClock(_blackClock)</div>
                </div>
            </div>
        </div>

    </aside>
</div>

@code {
    //Parameters

    [Parameter]
    [SupplyParameterFromQuery(Name = "GameId")]
    public Guid GameId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player1")]
    public string Player1Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Player2")]
    public string Player2Name { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "Computer")]
    public bool IsComputerOpponent { get; set; }

    //Parameters

    //Properties

    private bool isBusy = false;
    private string _optimizeMoveLoadingClassName = "chessboard";

    private HubConnection? _hubConnection;
    private Guid _currentUserGuid;
    private string _currentUserName = string.Empty;
    private DotNetObjectReference<Game>? _dotNetRef;
    private readonly List<GameNoteItem> _gameNotes = [];
    private int _player1Points;
    private int _player2Points;
    private DateTime _gameStartedAtUtc = DateTime.UtcNow;
    private TimeSpan _whiteClock = TimeSpan.FromMinutes(5);
    private TimeSpan _blackClock = TimeSpan.FromMinutes(5);
    private string _turnLabel = "White";
    private string _matchState = "Running";
    private CancellationTokenSource? _clockLoopCts;

    private ClickedBlockInformationDTO ClickedBlockInformationDTO = new ClickedBlockInformationDTO();

    private FigureColors MyColor => _currentUserName == Player1Name ? FigureColors.White : FigureColors.Black;

    //Properties

    //Reqeusts
    private MoveRequestDTO MoveRequestDTO = new MoveRequestDTO();
    private ClickRequestDTO ClickRequestDTO = new ClickRequestDTO();

    private SameFigureRequest SameFigureRequest = new SameFigureRequest();
    //Lifecycle Methods

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationState.GetAuthenticationStateAsync();
        _currentUserName = authState.User.Claims.First(claim => claim.Type == ClaimTypes.Name).Value;
        _currentUserGuid = Guid.Parse(authState.User.Claims.First(claim => claim.Type == ClaimTypes.NameIdentifier).Value);

        _hubConnection = await HubClient.GetHubConnectionAsync();

        await JS.ShowPlayers(Player1Name, Player2Name);

        var thisBoard = await GameRequestService.SendGameStateAsync(
            new PipeLineRequest<SendGameStateReqeustDTO>(
                new SendGameStateReqeustDTO()
                {
                    GameId = GameId
                }));

        if (thisBoard.Response.Data?.Board != null)
        {
            var blocks = thisBoard.Response.Data.Board.BoardBlocks;
            var jsonBoard = JsonSerializer.Serialize(blocks);

            var figureColor = _currentUserName == Player1Name ? 0 : 1;

            _dotNetRef?.Dispose();
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.ShowBoardState(jsonBoard, figureColor, _dotNetRef);

            InitializeRequests(GameId, _currentUserName, MyColor, ClickedBlockInformationDTO);
        }

        if (IsComputerOpponent && Player1Name == "Computer")
        {
            await AIMoveAtFirst();
        }
        
        StartClockLoop();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _dotNetRef is null)
            return;

        await jsRuneTime.InvokeVoidAsync("GameNotesTracker.register", _dotNetRef);
    }

    [JSInvokable]
    public Task OnBoardEvent(string eventType, string from, string to, bool isCapture)
    {
        var byPlayer = _currentUserName;
        var title = eventType switch
        {
            "move" => $"{from} -> {to}",
            "capture" => $"{from} x {to}",
            "check" => "King is checked",
            "mate" => "Checkmate",
            "helper" => $"Helper: {from} -> {to}",
            _ => eventType
        };

        _gameNotes.Add(new GameNoteItem
        {
            Title = title,
            ByPlayer = byPlayer,
            KindClass = eventType switch
            {
                "capture" => "note-capture",
                "check" => "note-check",
                "mate" => "note-mate",
                "helper" => "note-helper",
                _ => "note-move"
            },
            NoteBadge = eventType.ToUpperInvariant(),
            AtUtc = DateTime.UtcNow
        });

        if (isCapture)
        {
            if (_currentUserName == Player1Name)
                _player1Points++;
            else
                _player2Points++;
        }
        
        if (eventType is "move" or "capture")
        {
            _turnLabel = _turnLabel == "White" ? "Black" : "White";
        }
        else if (eventType == "mate")
        {
            _matchState = "Finished";
        }

        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnCellClick(int row, int col)
    {
        await HubClient.GetHubConnectionAsync();

        await JS.ClearSelectedBlocks((int)MyColor);

        SetUpRequestsPositions(new Position(row, col));

        var selectedPosition = ClickedBlockInformationDTO?.ClickedPosition;

        if (selectedPosition != null)
        {
            //TO DO:
            if (await IsSameFigureColor(MoveRequestDTO.CurrentPosition, selectedPosition, this.GameId))
            {
                await SelectFigure(ClickRequestDTO);
                return;
            }

            await Move(MoveRequestDTO);
            return;
        }

        await SelectFigure(ClickRequestDTO);
    }


    //private Methods
    //TO DO:
    private async Task<bool> IsSameFigureColor(Position selectedPosition, Position currentPosition, Guid gameId)
    {
        SameFigureRequest.Current = currentPosition;
        SameFigureRequest.Selected = selectedPosition;
        SameFigureRequest.GameId = gameId;

        var pipeLineRequest = new PipeLineRequest<SameFigureRequest>
        {
            Request = SameFigureRequest
        };

        var result = await GameRequestService.SendIsSameFigureClickedAsync(pipeLineRequest);

        return result.Response.Data.IsSameFigure;
    }

    private async Task<bool> SelectFigure(ClickRequestDTO requestDTO)
    {
        var pipeLineRequestPositionsResult = await GameRequestService.SendClickAsync(new PipeLineRequest<ClickRequestDTO>(requestDTO));

        if (!pipeLineRequestPositionsResult.Response.IsSuccess)
            return false;

        await JS.ShowMovableCutableBlocks(
            pipeLineRequestPositionsResult.Response.Data.CutableBlocks!,
            pipeLineRequestPositionsResult.Response.Data.MovableBlocks!,
            pipeLineRequestPositionsResult.Response.Data.CastlingInfosDTOs);

        ClickedBlockInformationDTO!.ClickedPosition = requestDTO.CurrentPosition;
        ClickedBlockInformationDTO.GameId = requestDTO.GameId;

        return true;
    }

    private async Task<bool> Move(MoveRequestDTO requestDTO)
    {
        //request Data Setup
        requestDTO.To = requestDTO.From;
        requestDTO.From = ClickedBlockInformationDTO.ClickedPosition;
        requestDTO.CurrentPlayerId = _currentUserGuid;

        var pipeLineResponsePositionsResult = await GameRequestService.SendMoveAsync(new PipeLineRequest<MoveRequestDTO>(requestDTO));

        if (!pipeLineResponsePositionsResult.Response.IsSuccess)
            return false;

        if (pipeLineResponsePositionsResult.Response.Data.IsReadyToEvent is IsReady.IsReadyToMove or IsReady.IsReadyToCastle)
            await JS.UpdateBoardAfterMove(requestDTO.From, requestDTO.To, (int)MyColor);
        else
            await JS.UpdateBoardAfterCut(requestDTO.From, requestDTO.To, (int)MyColor);

        ClickedBlockInformationDTO.ClickedPosition = default;
        return true;
    }

    private async Task<bool> AIMoveAtFirst()
    {
        var requestDTO = new MoveRequestDTO()
        {
            IsAIFirstMove = true,
            GameId = GameId,
            IsOpponentComputer = IsComputerOpponent,
            Player = _currentUserName,
            MyColor = MyColor,
            PreviusBlockInformationDTO = ClickedBlockInformationDTO,
            CurrentPlayerId = Guid.NewGuid(),
            From = new Position(-1, -1), // Indicate that AI should determine the move
            To = new Position(-1, -1), // Indicate that AI should determine the move
            CurrentPosition = new Position(-1, -1), // Indicate that AI should determine the move
            connectionId = _hubConnection?.ConnectionId!
        };
        var pipeLineResponsePositionsResult = await GameRequestService.SendMoveAsync(new PipeLineRequest<MoveRequestDTO>(requestDTO));

        if (!pipeLineResponsePositionsResult.Response.IsSuccess)
            return false;

        if (pipeLineResponsePositionsResult.Response.Data.IsReadyToEvent == IsReady.IsReadyToMove)
            await JS.UpdateBoardAfterMove(requestDTO.From, requestDTO.To, (int)MyColor);
        else
            await JS.UpdateBoardAfterCut(requestDTO.From, requestDTO.To, (int)MyColor);

        ClickedBlockInformationDTO.ClickedPosition = default;
        return true;
    }

    //Request Methods
    private void InitializeRequests(Guid gameId, string player, FigureColors myColor, ClickedBlockInformationDTO PreviusBlockInformationDTO)
    {
        MoveRequestDTO.GameId = gameId;
        ClickRequestDTO.GameId = gameId;
        MoveRequestDTO.IsOpponentComputer = IsComputerOpponent;

        MoveRequestDTO.Player = player;
        ClickRequestDTO.Player = player;

        MoveRequestDTO.MyColor = myColor;
        ClickRequestDTO.MyColor = myColor;

        MoveRequestDTO.PreviusBlockInformationDTO = PreviusBlockInformationDTO;
        ClickRequestDTO.PreviusBlockInformationDTO = PreviusBlockInformationDTO;
    }

    private void SetUpRequestsPositions(Position from)
    {
        MoveRequestDTO.CurrentPosition = from;
        MoveRequestDTO.From = from;
        ClickRequestDTO.CurrentPosition = from;
        ClickRequestDTO.From = from;
    }


    private async Task GetOptimizedMove()
    {
        if (isBusy)
            return;
        await JS.DisableAllGameState(_optimizeMoveLoadingClassName);
        isBusy = true;

        try
        {
            var optimizedMoveResponse = await ChessGameService.GetOptimizedMoveAsync(new GetOptimizedMoveRequestDTO()
            {
                GameId = GameId,
                ChosenColor = MyColor,
                IsMaximizingPlayer = true
            });

            if (optimizedMoveResponse is { IsSuccess: true })
            {
                await JS.ReceiveOptimalMoves(optimizedMoveResponse.Data.FromPosition, optimizedMoveResponse.Data.ToPosition);
            }
        }
        finally
        {
            isBusy = false;
            await JS.EnableAllGameState(_optimizeMoveLoadingClassName);
        }
    }

    private async Task LeaveGameAsync()
    {
        await HubClient.GetHubConnectionAsync();

        var leaveResponse =
            await _hubConnection!.InvokeAsync<ResponseDTO<RemoveUserFromGameResponseDTO, ChessGameResponseMessage>>(
                "LeaveGameAsync", GameId, _currentUserGuid);

        if (!leaveResponse.IsSuccess)
        {
            await JS.ShowErrorModal("Unable to leave the game right now. Please try again.");
            return;
        }

        await JS.NavigateTo("/dashboard");
    }

    private async Task OfferDraw()
    {
        _gameNotes.Add(new GameNoteItem
        {
            Title = "Draw offered",
            ByPlayer = _currentUserName,
            KindClass = "note-helper",
            NoteBadge = "DRAW",
            AtUtc = DateTime.UtcNow
        });
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartNewGame()
    {
        await LeaveGameAsync();
    }

    private static string ToBoardNotation(Position? position)
    {
        if (position is null || 
        ((int)position.HorizontalOrientation  < 0 || (int)position.HorizontalOrientation > 7) || 
        ((int)position.VerticalOrientation  < 0 || (int)position.VerticalOrientation  > 7))
            return "--";

        var file = (char)('a' + position.HorizontalOrientation);
        var rank = 8 - position.VerticalOrientation;
        return $"{file}{rank}";
    }

    private static string FormatElapsed(DateTime startedAtUtc)
    {
        var elapsed = DateTime.UtcNow - startedAtUtc;
        return $"{(int)elapsed.TotalMinutes:D2}:{elapsed.Seconds:D2}";
    }
    
    private static string FormatClock(TimeSpan clock)
        => $"{(int)clock.TotalMinutes:D2}:{clock.Seconds:D2}";

    private static string GetInitial(string? name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();

    private void StartClockLoop()
    {
        _clockLoopCts?.Cancel();
        _clockLoopCts = new CancellationTokenSource();
        var token = _clockLoopCts.Token;
        
        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
                while (await timer.WaitForNextTickAsync(token))
                {
                    if (_matchState != "Running")
                        continue;
                    
                    if (_turnLabel == "White")
                        _whiteClock = _whiteClock > TimeSpan.Zero ? _whiteClock.Subtract(TimeSpan.FromSeconds(1)) : TimeSpan.Zero;
                    else
                        _blackClock = _blackClock > TimeSpan.Zero ? _blackClock.Subtract(TimeSpan.FromSeconds(1)) : TimeSpan.Zero;

                    if (_whiteClock == TimeSpan.Zero || _blackClock == TimeSpan.Zero)
                    {
                        _matchState = "Finished";
                        _gameNotes.Add(new GameNoteItem
                        {
                            Title = "Time over",
                            ByPlayer = "System",
                            KindClass = "note-check",
                            NoteBadge = "TIME",
                            AtUtc = DateTime.UtcNow
                        });
                    }
                    
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                // no-op
            }
        }, token);
    }

    public async ValueTask DisposeAsync()
    {
        _clockLoopCts?.Cancel();
        _clockLoopCts?.Dispose();
        try
        {
            await jsRuneTime.InvokeVoidAsync("GameNotesTracker.unregister");
        }
        catch
        {
            // No-op: safe cleanup for navigation/dispose race.
        }
        
        _dotNetRef?.Dispose();
    }

    private sealed class GameNoteItem
    {
        public string Title { get; set; } = string.Empty;
        public string ByPlayer { get; set; } = string.Empty;
        public string KindClass { get; set; } = "note-move";
        public string NoteBadge { get; set; } = "MOVE";
        public DateTime AtUtc { get; set; } = DateTime.UtcNow;
    }
}
