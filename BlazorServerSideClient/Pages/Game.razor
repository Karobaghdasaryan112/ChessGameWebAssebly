@page "/game"
@using ChessGameBlazorClient.ServiceEndpoints
@using ChessGameBlazorClient.UI.Services
@using Microsoft.AspNetCore.SignalR.Client
@using SharedResources.ChessGameResource.Models
@inject SignalRService HubClient
@inject NavigationManager Navigation
@attribute [Authorize]
<h3>Game Page</h3>

<p>Player 1: @Player1?.UserName</p>
<p>Player 2: @Player2?.UserName</p>
<div class="chessboard">
    @for (int row = 8; row >= 1; row--)
    {
        <div class="row">
            @for (int col = 1; col <= 8; col++)
            {
                var isBlack = (row + col) % 2 == 0;
                <div class="cell @(isBlack ? "black" : "white")">
                </div>
            }
        </div>
    }
</div>

<style>
    .chessboard { display: inline-block; border: 2px solid #333; }
    .row { display: flex; }
    .cell { width: 100px; height: 100px; }
    .white { background-color: #f0d9b5; }
    .black { background-color: #b58863; }
</style>

@if (_hubConnection == null)
{
    <p>Connecting to game server...</p>
}
else
{
    <p>Connected to game hub</p>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "GameId")]
    public Guid GameId { get; set; }

    private UserConnection Player1{ get; set; }

    private UserConnection Player2{ get; set; }


    private HubConnection? _hubConnection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _hubConnection = await HubClient.GetHubConnection();


        await _hubConnection.InvokeAsync("GetPlayersInformation", GameId.ToString());

        _hubConnection.On<List<UserConnection>>("ReceivePlayers", async (connections) =>
        {
            Player1 = connections.First();
            Player2 = connections.Last();

            await InvokeAsync(StateHasChanged);
        });

    }

    protected override async Task OnInitializedAsync()
    {
        
    }

    public async Task SendMoveAsync(string move)
    {
        await _hubConnection!.InvokeAsync("SendMove", Player1, move);
    }
}
