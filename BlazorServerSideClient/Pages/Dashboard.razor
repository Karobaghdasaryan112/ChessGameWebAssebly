@page "/Dashboard"
@using ChessGameBlazorClient.UI.Services
@using SharedResources.ChessGameResource.Models
@using System.Security.Claims
@using System.Threading
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject SignalRService HubClient

<div class="dashboard-container">
    <h2 class="dashboard-title">🎮 Player Dashboard</h2>

    @if (activeGamers.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-emoji-frown"></i>
            <p>No players online right now</p>
        </div>
    }
    else
    {
        <div class="players-list">
            @{
                var authState = AuthStateProvider.GetAuthenticationStateAsync().Result;
                var currentUserGuid = authState.User?.Claims?.FirstOrDefault(claim => claim.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            }

            @foreach (var player in activeGamers)
            {
                if (player.Key != currentUserGuid)
                {
                    <div class="player-card">
                        <div class="player-info">
                            <div class="avatar">@player.Value.UserName.Substring(0, 1).ToUpper()</div>
                            <div>
                                <strong>@player.Value.UserName</strong>
                                @if (player.Value.Gameinfo == null)
                                {
                                    <p class="status-online">🟢 Online</p>
                                }
                                else
                                {
                                    <p class="status-ingame">🎯 In Game</p>
                                }
                            </div>
                        </div>

                        @if (player.Value.Gameinfo == null)
                        {
                            <button class="invite-btn" @onclick="() => SendInviteAsync(player)">
                                Invite
                            </button>
                        }
                        else
                        {
                            <button class="invite-btn disabled" disabled>
                                Busy
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<KeyValuePair<string, UserConnection>> activeGamers = new();
    private ClaimsPrincipal user => AuthStateProvider.GetAuthenticationStateAsync().GetAwaiter().GetResult().User;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        UnAuthorizedUser();

        HubClient.OnlinePlayersUpdated += (players) =>
        {
            activeGamers = players;
            InvokeAsync(StateHasChanged);
        };

        var userGuid = user.Claims.First(c => c.Type == ClaimTypes.NameIdentifier)?.Value!;
        var userName = user.Claims.First(c => c.Type == ClaimTypes.Name)?.Value!;

        await HubClient.GetHubConnection();
        await HubClient.InitializeAsync(userGuid, userName);
    }

    protected override async Task OnInitializedAsync()
    {
        UnAuthorizedUser();

        var userGuid = user.Claims.First(c => c.Type == ClaimTypes.NameIdentifier)?.Value!;
        await RefreshGamers(userGuid);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshGamers(object obj)
    {
        if (obj is string userGuid)
            await HubClient.GetOnlinePlayersAsync(userGuid);
    }

    private async Task SendInviteAsync(KeyValuePair<string, UserConnection> player)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var myGuid = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value!;
        await HubClient.GetHubConnection();
        await HubClient.SendInviteAsync(player.Key, myGuid);
    }

    private void UnAuthorizedUser()
    {
        if (user.Identity?.IsAuthenticated == false)
            Navigation.NavigateTo("/Identity/Account/Login?returnUrl=/Dashboard", true);
    }
}
