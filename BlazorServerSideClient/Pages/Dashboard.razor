@page "/Dashboard"
@using BlazorServerSideClient.Contracts.Handlers
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Models
@using BlazorServerSideClient.Services
@using ChessGameBlazorClient.ServiceEndpoints
@using SharedResources.DTOs.ChessGameDTOs.ChessGameSharedDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionDTOs.GameRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.UserConnectionRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.InvitationRequestDTOs
@using ChessGameBlazorClient.UI.Services
@using System.Security.Claims
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.MediatRRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.ConnectionResponsDTOs.InvitationResponseDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.MediatRResponseDTOs
@using SharedResources.Responses.ResponseMessages

@inject AuthenticationStateProvider AuthStateProvider
@inject IInivitationReqeustService InvitationRequest
@inject IConnectionHandlerService ConnectionHandler
@inject IGameRequestService GameRequest
@inject IGameHandlerService GameHandler
@inject IInvitationHandlerService InvitationHandler
@inject IConnectionReqeustService ConnectionRequest
@inject NavigationManager Navigation
@inject SignalRService HubClient
@inject JSRunetimeService jsRuntime
@inject ILogger<Dashboard> logger
@inject IJSRuntime JS



<DashboardInvitationRequest />

<div class="dashboard-container">
    <h2 class="dashboard-title">🎮 Player Dashboard</h2>
    @if (activeGamers.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-emoji-frown"></i>
            <p>No players online right now</p>
        </div>
    }
    else
    {
        <div class="players-list">
            @{
                var authState = AuthStateProvider.GetAuthenticationStateAsync().Result;
                var currentUserId = authState.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            }

            @foreach (var player in activeGamers)
            {
                if (Guid.TryParse(currentUserId, out var currentUserGuid))
                {
                    if (player.Key != currentUserGuid)
                    {
                        <div class="player-card">
                            <div class="player-info">
                                <div class="avatar">@player.Value.UserName.Substring(0, 1).ToUpper()</div>
                                <div>
                                    <strong>@player.Value.UserName</strong>
                                    @if (player.Value.Gameinfo == null)
                                    {
                                        <p class="status-online">🟢 Online</p>
                                    }
                                    else
                                    {
                                        <p class="status-ingame">🎯 In Game</p>
                                    }
                                </div>
                            </div>

                            @if (player.Value.Gameinfo == null)
                            {
                                <button class="invite-btn" @onclick="() => SendInviteAsync(player)">Invite</button>
                            }
                            else
                            {
                                <button class="invite-btn disabled" disabled>Busy</button>
                            }
                        </div>
                    }
                }
            }
        </div>
    }
</div>

@code {
    private string _connectionId = String.Empty;
    private Dictionary<Guid, UserConnectionDTO> activeGamers = new();
    private ClaimsPrincipal user => AuthStateProvider.GetAuthenticationStateAsync().GetAwaiter().GetResult().User;
    private DotNetObjectReference<IInvitationHandlerService> DotNetRefInvitation;
    private DotNetObjectReference<IGameHandlerService> DotNetRefGame;
    private DotNetObjectReference<IConnectionHandlerService> DotNetRefConnection;


    public Action<ResponseDTO<SendInvitationsResponseDTO, ChessGameResponseMessage>> OnReceived { get; set; }
    protected override async Task OnInitializedAsync()
    {
        DotNetRefInvitation = DotNetObjectReference.Create(InvitationHandler);
        DotNetRefGame = DotNetObjectReference.Create(GameHandler);
        DotNetRefConnection = DotNetObjectReference.Create(ConnectionHandler);
        UnAuthorizedUser();

        var userGuid = user.FindFirst(ClaimTypes.NameIdentifier)?.Value!;
        var userName = user.FindFirst(ClaimTypes.Name)?.Value!;



        ConnectionHandler.OnlinePlayersUpdated += (player) =>
        {
            activeGamers[player.Key] = player.Value;
            InvokeAsync(StateHasChanged);
        };
        
        var chessHub = await JS.InvokeAsync<IJSObjectReference>(
            "ChessGame",
            BasePaths.baseUrlHub,
            userName,
            userGuid,
            DotNetRefInvitation,
            DotNetRefGame,
            DotNetRefConnection);

        var info = await JS.InvokeAsync<SignalRConnectionInfoModel>("getSignalRConnectionInfo");

        if (info is null)
        {
            return;
        }
        _connectionId = info.ConnectionId;


        if (Guid.TryParse(userGuid, out var userIdAsGuid))
        {
            await ConnectionRequest.AddConnectionAsync(
          new AddUserConnectionRequestDTO()
          {
              userConnection = new UserConnectionDTO()
              {
                  ConnectionId = info.ConnectionId!,
                  Gameinfo = null,
                  GameId = Guid.Empty,
                  UserName = userName
              },
              userGuid = userIdAsGuid
          });

            var allGamers = await GameRequest.GetOnlinePlayersAsync(
                new GetONlinePlayersRequestDTO()
                {
                    UserGuid = userIdAsGuid
                });

            if (allGamers.IsSuccess)
                activeGamers = allGamers.Data.OnlinePlayers!;

        }
    }


    private async Task SendInviteAsync(KeyValuePair<Guid, UserConnectionDTO> receiverPlayer)
    {
        var userName = user.Claims.First(c => c.Type == ClaimTypes.Name)?.Value!;
        var inviterUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value!;
        var receiverUserGuid = receiverPlayer.Key;
        if (Guid.TryParse(inviterUserId, out var inviterUserGuid))
        {
            var sendInviteRequest = new SendInvitationRequestDTO()
            {
                ReceiverUserConnection = receiverPlayer.Value,
                InviterUserConnection = new UserConnectionDTO()
                {
                    ConnectionId = _connectionId,
                    UserName = userName
                },
                InviterPlayerId = inviterUserGuid,
                ReceiverPlayerId = receiverUserGuid
            };
            await InvitationRequest.SendInviteAsync(sendInviteRequest);
        }
    }

    private void UnAuthorizedUser()
    {
        if (user.Identity?.IsAuthenticated == false)
            Navigation.NavigateTo("/Identity/Account/Login?returnUrl=/Dashboard", true);
    }

}
