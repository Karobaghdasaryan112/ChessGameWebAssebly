@using ChessGameBlazorClient.UI.Services
@using ChessGame.Infrastructure.Infrastructure.Hubs
@inject AuthenticationStateProvider AuthStateProvider
@inject SignalRService HubClient
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User?.Identity?.IsAuthenticated == true)
        {
            var user = authState.User;
            var userGuid = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var userName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;
            await HubClient.GetHubConnection();
            await HubClient.InitializeAsync(userGuid!, userName!);
        }
    }
}
