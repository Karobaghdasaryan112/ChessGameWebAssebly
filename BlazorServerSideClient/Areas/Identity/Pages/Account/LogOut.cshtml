@page
@using System.Security.Claims
@using BlazorServerSideClient.Services
@using Microsoft.JSInterop
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.UserConnectionRequestDTOs
@attribute [IgnoreAntiforgeryToken]
@inject SignInManager<ApplicationUser> SignInManager
@inject JSRunetimeService JsRunetime
@inject IJSRuntime runTime


@functions 
{
    public async Task<IActionResult> OnPost()
    {
        if (SignInManager.IsSignedIn(User))
        {
            var userGuid = User.Claims.FirstOrDefault(claim => claim.Type == ClaimTypes.NameIdentifier)?.Value;
            var userName = User.Claims.FirstOrDefault(claim => claim.Type == ClaimTypes.Name)?.Value;

            var userConnectionDTO = new RemoveUserConnectionRequestDTO
            {
                UserGuid = Guid.Parse(userGuid),
                ConnectionId = null
            };
            
            await SignInManager.SignOutAsync();
        }

        return Redirect("~/");
    }
}
