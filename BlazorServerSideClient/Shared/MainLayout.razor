@using BlazorServerSideClient.Contracts.Handlers
@using BlazorServerSideClient.Services
@using BlazorServerSideClient.Services.Handlers
@using ChessGameBlazorClient.ServiceEndpoints
@using System.Security.Claims
@using ChessGameBlazorClient.UI.Services
@inherits LayoutComponentBase

@inject SignalRService signalRService
@inject NavigationManager Nav
@inject ILogger<MainLayout> Logger
@inject AuthenticationStateProvider AuthProvider
<DashboardInvitationRequest />
<PageTitle>BlazorServerSideClient</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 auth">
            <LoginDisplay />
            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        await signalRService.GetHubConnection();
        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Logger.LogWarning("User is not authenticated.");
            Nav.NavigateTo("/Identity/Account/Login");
            return;
        }

        var userName = user.FindFirst(ClaimTypes.Name)?.Value;
        var userGuid = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(userName) || string.IsNullOrEmpty(userGuid))
        {
            Logger.LogWarning("User claims not found.");
            return;
        }



    }
}