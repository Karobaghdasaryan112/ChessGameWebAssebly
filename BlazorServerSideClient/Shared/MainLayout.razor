@using BlazorServerSideClient.Contracts.Handlers
@using BlazorServerSideClient.Services
@using BlazorServerSideClient.Services.Handlers
@using ChessGameBlazorClient.ServiceEndpoints
@using System.Security.Claims
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ILogger<MainLayout> Logger
@inject AuthenticationStateProvider AuthProvider
<PageTitle>BlazorServerSideClient</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4 auth shell-topbar">
            <div class="topbar-brand">
                <span class="brand-mark">♟</span>
                <div>
                    <div class="brand-title">Chess Arena</div>
                    <div class="brand-subtitle">Play, learn, and review your games</div>
                </div>
            </div>
            <LoginDisplay />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

