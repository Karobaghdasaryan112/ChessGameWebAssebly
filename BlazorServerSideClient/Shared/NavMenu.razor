@using ChessGameBlazorClient.UI.Services
@using System.Security.Claims
@using SharedResources.ChessGameResource.Models
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs
@inject NavigationManager NavigationManager
@inject SignalRService HubClient
@inject IJSRuntime JS
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthState
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BlazorServerSideClient</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="HomeClicked">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" @onclick="DashboardClicked">
                <span class="oi oi-people" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" @onclick="HistoryClicked">
                <span class="oi oi-people" aria-hidden="true"></span> History-Widgets
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" @onclick="TrainingClicked">
                <span class="oi oi-people" aria-hidden="true"></span> Training
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private ClaimsPrincipal user => AuthState.GetAuthenticationStateAsync().GetAwaiter().GetResult().User;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task HomeClicked(MouseEventArgs e)
    {
        if (user.Identity?.IsAuthenticated == false)
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

    }

    private void DashboardClicked(MouseEventArgs e)
    {
        NavigationManager.NavigateTo("/dashboard", true);
    }

    private void HistoryClicked(MouseEventArgs e)
    {
        NavigationManager.NavigateTo("/HistoryWidgets", true);
    }
    private void TrainingClicked(MouseEventArgs e)
    {
        NavigationManager.NavigateTo("/Training", true);
    }
}
