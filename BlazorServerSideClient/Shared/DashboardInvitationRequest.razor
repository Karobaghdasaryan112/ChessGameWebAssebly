@using BlazorServerSideClient.Contracts.Handlers
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Services
@using SharedResources.ChessGameResource.Enums.Events
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.InvitationRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.ConnectionResponsDTOs.InvitationResponseDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.MediatRResponseDTOs
@using SharedResources.PipeLine.PipeLineContext
@using SharedResources.Responses.ResponseMessages

@inject IInvitationHandlerService InvitationHandlerService
@inject SignalRService HubClient
@inject IInivitationReqeustService InvitationRequestService
@inject JSRunetimeService JSRunetimeService

@attribute [Authorize]
@implements IDisposable
<div class="invite-backdrop" id="invite-backdrop-Id" hidden>
    <div class="invite-modal" role="dialog" aria-modal="true" aria-labelledby="invite-title">
        <div class="invite-modal-top">
            <div class="invite-chess-icon">♞</div>

            <div class="invite-title-block">
                <div class="invite-pill">
                    <span class="invite-live-dot"></span>
                    Live Request
                </div>

                <h3 id="invite-title">Game Invitation</h3>
            </div>
        </div>

        <div class="invite-content">
            <div class="invite-player-box">
                <span class="invite-small-label">Invited by</span>

                <strong id="Inviter-Name" class="invite-player-name">@InviterUserName</strong>

                <p>Wants to play a chess match with you.</p>
            </div>

            <div class="invite-info-list">
                <div class="invite-info-row">
                    <span>Game mode</span>
                    <strong>@currentPlayEvent</strong>
                </div>

                <div class="invite-info-row">
                    <span>Time control</span>
                    <strong>@GetMinutes(currentPlayEvent) min</strong>
                </div>

                <div class="invite-info-row">
                    <span>Auto-decline</span>
                    <strong><span id="Inviter-Time-Value">30</span> sec</strong>
                </div>
            </div>
        </div>

        <div class="modal-buttons">
            <button class="accept-btn"
                    disabled="@_isProcessing"
                    @onclick="AcceptInvite">
                @if (_isProcessing)
                {
                    <span class="invite-spinner"></span>
                    <span>Accepting</span>
                }
                else
                {
                    <span>Accept</span>
                }
            </button>

            <button class="decline-btn"
                    disabled="@_isProcessing"
                    @onclick="DeclineInvite">
                Decline
            </button>
        </div>
    </div>
</div>

@code {
    private PlayEvent currentPlayEvent;

    private Guid ReceiverUserGuid { get; set; }

    private Guid InviterUserGuid { get; set; }

    public string InviterUserName { get; set; }

    private string? _connectionId;

    private bool _isProcessing;

    private Action<ResponseDTO<SendInvitationsResponseDTO, ChessGameResponseMessage>>? _inviteReceivedHandler;

    protected override void OnInitialized()
    {
        _inviteReceivedHandler = sendInvitationResponseDTO =>
        {
            InviterUserName = sendInvitationResponseDTO.Data.InviterUserConnection.UserName;
            ReceiverUserGuid = sendInvitationResponseDTO.Data.ReceiverUserGuid;
            InviterUserGuid = sendInvitationResponseDTO.Data.InviterUserGuid;
            currentPlayEvent = sendInvitationResponseDTO.Data.PlayEvent;

            InvokeAsync(StateHasChanged);
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var hub = await HubClient.GetHubConnectionAsync();
            _connectionId = hub.ConnectionId;

            await JSRunetimeService.HideInviteModal();

            if (_inviteReceivedHandler is not null)
                InvitationHandlerService.OnReceived += _inviteReceivedHandler;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during invitation modal initialization: {ex.Message}");
        }
    }

    private async Task AcceptInvite()
    {
        if (_isProcessing)
            return;

        _isProcessing = true;

        try
        {
            await InvitationRequestService.AcceptInviteAsync(
                new PipeLineRequest<AcceptInvitationRequestDTO>(
                    new AcceptInvitationRequestDTO
                    {
                        PlayEvent = currentPlayEvent,
                        inviterUserGuid = InviterUserGuid,
                        receiverUserGuid = ReceiverUserGuid
                    }));
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task DeclineInvite()
    {
        if (_isProcessing)
            return;

        await JSRunetimeService.HideInviteModal();
        await InvokeAsync(StateHasChanged);
    }

    private static int GetMinutes(PlayEvent evt)
    {
        return Math.Max(1, (int)evt / 60);
    }

    public void Dispose()
    {
        if (_inviteReceivedHandler is not null)
            InvitationHandlerService.OnReceived -= _inviteReceivedHandler;
    }

}