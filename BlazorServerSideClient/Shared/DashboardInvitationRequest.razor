@using BlazorServerSideClient.Contracts.Handlers
@using BlazorServerSideClient.Contracts.Requests
@using BlazorServerSideClient.Services
@using SharedResources.DTOs.ChessGameDTOs.RequestDTOs.ConnectionRequestDTOs.InvitationRequestDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.ConnectionResponsDTOs.InvitationResponseDTOs
@using SharedResources.DTOs.ChessGameDTOs.ResponseDTOs.MediatRResponseDTOs
@using SharedResources.PipeLine.PipeLineContext
@using SharedResources.Responses.ResponseMessages
@inject IInvitationHandlerService InvitationHandlerService
@inject SignalRService hubClient;
@inject IInivitationReqeustService InvitationRequestService
@inject JSRunetimeService JSRunetimeService
@attribute [Authorize]
@implements IDisposable

<div class="invite-backdrop" id="invite-backdrop-Id" hidden>
    <div class="invite-modal bounce-in">
        <h3>🎯 Game Invitation</h3>

        <p>
            <strong id="Inviter-Name"></strong> invited you to a chess match!
        </p>

        <p class="timer" id="Inviter-Time-Value">Auto-decline in <strong></strong> sec...</p>

        <div class="modal-buttons">
            <button class="accept-btn" @onclick="AcceptInvite">Accept</button>
            <button class="decline-btn" @onclick="DeclineInvite">Decline</button>
        </div>
    </div>
</div>
<style>
    :root {
        --bg: #0f1724;
        --card: #0f1724aa;
        --glass: rgba(255,255,255,0.06);
        --accent: linear-gradient(135deg,#7f5af0,#4cc9f0);
        --muted: #9aa4b2;
        --white: #f8fafc;
        --cell-light: #f3efe9;
        --cell-dark: #2e3440;
        --board-radius: 18px;
        --gap: 18px;
        --board-size: min(72vmin,720px);
        --cell-radius: 8px;
        font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }

    html, body {
        height: 100%;
        margin: 0;
        background: radial-gradient(1000px 400px at 10% 10%, rgba(124,58,237,0.12), transparent 8%), radial-gradient(800px 300px at 95% 90%, rgba(76,201,240,0.06), transparent 10%), var(--bg);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        color: var(--white);
    }
</style>
@code {
    private static Guid ReceiverUserGuid { get; set; }
    private static Guid InviterUserGuid { get; set; }
    private string _connectionId { get; set; }
    private Action<ResponseDTO<SendInvitationsResponseDTO, ChessGameResponseMessage>>? _inviteReceivedHandler;

    protected override async Task OnInitializedAsync()
    {
        _connectionId = (await hubClient.GetHubConnectionAsync()).ConnectionId!;

        await JSRunetimeService.HideInviteModal();

        _inviteReceivedHandler = (sendInvitationResponseDTO) =>
        {
            ReceiverUserGuid = sendInvitationResponseDTO.Data.ReceiverUserGuid;
            InviterUserGuid = sendInvitationResponseDTO.Data.InviterUserGuid;
        };
        InvitationHandlerService.OnReceived += _inviteReceivedHandler;

    }

    private async Task AcceptInvite()
    {

        await InvitationRequestService.AcceptInviteAsync(
            new PipeLineRequest<AcceptInvitationRequestDTO>(new AcceptInvitationRequestDTO()
            {
                inviterUserGuid = InviterUserGuid,
                receiverUserGuid = ReceiverUserGuid
            })
           );
    }

    private async Task DeclineInvite()
    {
        await JSRunetimeService.HideInviteModal();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_inviteReceivedHandler != null)
        {
            InvitationHandlerService.OnReceived -= _inviteReceivedHandler;
        }
    }
}
