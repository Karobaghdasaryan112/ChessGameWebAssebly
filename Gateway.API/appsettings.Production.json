{
  "ReverseProxy": {
    "route2": {
      "ClusterId": "cluster2",
      "Match": {
        "Path": "api/chessgame/{**catch-all}"
      }
    },
    "route3": {
      "ClusterId": "cluster3",
      "Match": {
        "Path": "gamehub/{**catch-all}"
      }
    },
    "route4": {
      "ClusterId": "cluster4",
      "Match": {
        "Path": "/api/Identity/{**catch-all}"
      }
    },
  "cluster2": {
    "Destinations": {
      "destination2": {
        "Address": "http:/chessgame.api:8080/"
      }
    }
  },
  "cluster3": {
    "Destinations": {
      "destination3": {
        "Address": "http:/chessgame.api:8080/gamehub"
      }
    }
  },
  "cluster4": {
    "Destinations": {
      "destination4": {
        "Address": "https://localhost:7287/"
      }
    }
  }
},
    "Logging": {
    "LogLevel": {
    "Default": "Information",
    "Microsoft.AspNetCore": "Warning"
    }
    },
    "AllowedHosts": "*"
} 
  
